<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Meister-Angler 2D</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Quicksand:wght@500;600;700&display=swap');

        body {
            font-family: 'Quicksand', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            background-color: #0f172a;
        }

        .font-game {
            font-family: 'Fredoka One', cursive;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #2563eb;
        }

        .badge-common { background-color: #9ca3af; color: #111827; }
        .badge-uncommon { background-color: #22c55e; color: #052e16; }
        .badge-rare { background-color: #3b82f6; color: #172554; }
        .badge-epic { background-color: #a855f7; color: #3b0764; }
        .badge-legendary { background-color: #eab308; color: #422006; font-weight: bold; }

        canvas {
            touch-action: none;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col text-slate-100 bg-slate-900">

    <!-- TOP HEADER / STATS BAR -->
    <header class="bg-slate-800/90 border-b border-slate-700/80 px-4 py-2 flex items-center justify-between z-20 shadow-md">
        <div class="flex items-center space-x-3">
            <div class="flex items-center bg-slate-900/80 px-3 py-1.5 rounded-xl border border-amber-500/30">
                <i class="fa-solid fa-coins text-amber-400 text-lg mr-2"></i>
                <span id="player-coins" class="font-game text-amber-300 text-lg">0</span>
            </div>
            <div class="flex items-center bg-slate-900/80 px-3 py-1.5 rounded-xl border border-blue-500/30">
                <i class="fa-solid fa-star text-blue-400 text-lg mr-2"></i>
                <span id="player-level" class="font-game text-blue-300 text-base">Lvl 1</span>
                <div class="w-16 bg-slate-700 h-2.5 rounded-full ml-2 overflow-hidden border border-slate-600">
                    <div id="xp-bar" class="bg-blue-500 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>
        </div>

        <!-- Location Badge -->
        <div id="current-location-display" class="hidden sm:flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded-xl border border-emerald-500/30 text-emerald-400">
            <i class="fa-solid fa-map-location-dot"></i>
            <span id="location-name-hdr" class="font-bold text-sm">Idyllischer Waldsee</span>
        </div>

        <div class="flex items-center space-x-2">
            <button id="sound-toggle-btn" onclick="game.toggleSound()" class="p-2 bg-slate-700 hover:bg-slate-600 rounded-xl transition text-slate-300">
                <i id="sound-icon" class="fa-solid fa-volume-high"></i>
            </button>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <div class="flex-1 flex flex-col md:flex-row relative overflow-hidden">
        
        <!-- CANVAS AREA (FISHING ZONE) -->
        <div class="relative flex-1 h-full w-full bg-slate-950 flex flex-col items-center justify-center overflow-hidden">
            <canvas id="gameCanvas" class="w-full h-full block cursor-crosshair"></canvas>

            <!-- On-Canvas UI Overlays -->

            <!-- Bite Indicator Prompt -->
            <div id="bite-prompt" class="absolute top-1/4 hidden flex-col items-center animate-bounce pointer-events-none">
                <div class="bg-red-600 text-white font-game text-2xl sm:text-4xl px-6 py-2 rounded-2xl shadow-2xl border-4 border-yellow-300 tracking-wider">
                    BISS! KLICKE JETZT!
                </div>
            </div>

            <!-- Cast Power Bar Overlay -->
            <div id="power-bar-container" class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden flex-col items-center bg-slate-900/90 border border-slate-700 p-3 rounded-2xl shadow-2xl backdrop-blur-md">
                <span class="text-xs font-bold text-amber-400 mb-1 uppercase tracking-wider">Wurfstärke</span>
                <div class="w-64 sm:w-80 h-6 bg-slate-800 rounded-xl overflow-hidden border border-slate-600 p-0.5">
                    <div id="power-bar-fill" class="h-full bg-gradient-to-r from-green-500 via-yellow-400 to-red-500 rounded-lg w-0"></div>
                </div>
                <span class="text-xs text-slate-400 mt-1">Klicke zum Auswerfen!</span>
            </div>

            <!-- Tension Control Minigame Widget -->
            <div id="minigame-container" class="absolute bottom-6 right-6 sm:bottom-10 sm:right-10 hidden flex-col items-center bg-slate-900/90 border-2 border-slate-700 p-4 rounded-3xl shadow-2xl backdrop-blur-md w-72">
                <div class="flex justify-between w-full mb-1 text-xs font-bold">
                    <span class="text-emerald-400"><i class="fa-solid fa-fish mr-1"></i> EINHOLEN</span>
                    <span id="tension-text" class="text-amber-400">Spannung OK</span>
                </div>

                <!-- Easy visual guidance help banner -->
                <div class="w-full bg-slate-950/80 border border-amber-500/40 text-amber-300 text-[11px] font-bold py-1 px-2 rounded-lg text-center mb-2">
                    <i class="fa-solid fa-circle-info mr-1"></i> Halte den Fisch im GRÜNEN Bereich!
                </div>

                <!-- Reeling Track Container -->
                <div class="relative w-full h-64 bg-slate-950 border-2 border-slate-800 rounded-2xl overflow-hidden flex justify-center">
                    <!-- Target Catch Zone (Green Area) -->
                    <div id="target-zone" class="absolute w-full bg-emerald-500/40 border-y-2 border-emerald-400 rounded-lg transition-all duration-75"></div>
                    <!-- Fish Icon -->
                    <div id="fish-icon" class="absolute text-amber-300 text-xl transition-all duration-75 -translate-y-1/2 z-10">
                        <i class="fa-solid fa-fish"></i>
                    </div>
                </div>

                <!-- Tension Indicator Meter -->
                <div class="w-full mt-3">
                    <div class="flex justify-between text-[10px] text-slate-400 mb-1">
                        <span>Schnurdruck</span>
                        <span id="tension-percent">0%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-3 rounded-full overflow-hidden border border-slate-700">
                        <div id="tension-bar-fill" class="h-full bg-blue-500 transition-all duration-100 w-0"></div>
                    </div>
                </div>

                <div class="mt-3 text-center">
                    <button id="reel-btn" class="w-full py-3 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 active:scale-95 text-slate-950 font-game text-lg rounded-xl shadow-lg transition select-none">
                        HALTEN ZUM ZIEHEN
                    </button>
                    <span class="text-[11px] text-slate-400 mt-1 block">Oder Halte [LEERTASTE] / Touch</span>
                </div>
            </div>

            <!-- Catch Result Popup Modal -->
            <div id="catch-modal" class="absolute inset-0 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4 z-30">
                <div class="bg-slate-800 border-2 border-amber-500/50 rounded-3xl p-6 max-w-sm w-full text-center shadow-2xl relative animate-scaleUp">
                    <div id="catch-rarity-badge" class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest font-bold mb-2">SELTEN</div>
                    <h2 id="catch-fish-name" class="text-2xl font-game text-white mb-1">Flussbarsch</h2>
                    <p id="catch-fish-desc" class="text-slate-400 text-xs italic mb-4">Ein räuberischer Süßwasserfisch mit gestreiftem Muster.</p>
                    
                    <div class="bg-slate-900/80 rounded-2xl p-4 border border-slate-700/60 mb-5 space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-slate-400">Größe:</span>
                            <span id="catch-fish-size" class="font-bold text-amber-300">32 cm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Gewicht:</span>
                            <span id="catch-fish-weight" class="font-bold text-amber-300">0.85 kg</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Verkaufswert:</span>
                            <span id="catch-fish-value" class="font-bold text-emerald-400">+45 Münzen</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Erfahrung:</span>
                            <span id="catch-fish-xp" class="font-bold text-blue-400">+15 XP</span>
                        </div>
                    </div>

                    <button onclick="game.closeCatchModal()" class="w-full py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-game text-lg rounded-xl shadow-lg transition transform active:scale-95">
                        SUPER!
                    </button>
                </div>
            </div>

        </div>

        <!-- NAVIGATION & TAB MENUS (BOTTOM OR RIGHT PANEL) -->
        <div class="w-full md:w-96 bg-slate-800 border-t md:border-t-0 md:border-l border-slate-700 flex flex-col z-10 shadow-2xl max-h-[50vh] md:max-h-full">
            
            <!-- TABS BUTTONS -->
            <div class="flex bg-slate-900/90 border-b border-slate-700 p-1.5 space-x-1 overflow-x-auto text-xs font-bold">
                <button onclick="game.switchTab('shop')" id="tab-btn-shop" class="tab-btn flex-1 py-2 px-2 rounded-xl text-center transition flex items-center justify-center space-x-1 bg-slate-800 text-amber-400">
                    <i class="fa-solid fa-store"></i> <span>Shop</span>
                </button>
                <button onclick="game.switchTab('gear')" id="tab-btn-gear" class="tab-btn flex-1 py-2 px-2 rounded-xl text-center transition flex items-center justify-center space-x-1 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-toolbox"></i> <span>Ausrüstung</span>
                </button>
                <button onclick="game.switchTab('log')" id="tab-btn-log" class="tab-btn flex-1 py-2 px-2 rounded-xl text-center transition flex items-center justify-center space-x-1 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-book-open"></i> <span>Fangbuch</span>
                </button>
                <button onclick="game.switchTab('locations')" id="tab-btn-locations" class="tab-btn flex-1 py-2 px-2 rounded-xl text-center transition flex items-center justify-center space-x-1 text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-map"></i> <span>Gewässer</span>
                </button>
            </div>

            <!-- TAB CONTENT CONTAINER -->
            <div class="flex-1 overflow-y-auto p-4 space-y-4">
                
                <!-- SHOP TAB -->
                <div id="tab-shop" class="tab-content space-y-4">
                    <h3 class="font-game text-lg text-amber-400 border-b border-slate-700 pb-2 flex items-center justify-between">
                        <span><i class="fa-solid fa-fish-fins mr-2"></i>Angelbedarf Shop</span>
                    </h3>

                    <!-- Rods Section -->
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Angelruten</h4>
                        <div id="shop-rods-list" class="space-y-2"></div>
                    </div>

                    <!-- Baits Section -->
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Köder Vorrat</h4>
                        <div id="shop-baits-list" class="grid grid-cols-1 gap-2"></div>
                    </div>
                </div>

                <!-- GEAR / EQUIPMENT TAB -->
                <div id="tab-gear" class="tab-content hidden space-y-4">
                    <h3 class="font-game text-lg text-blue-400 border-b border-slate-700 pb-2">
                        <i class="fa-solid fa-toolbox mr-2"></i>Aktuelle Ausrüstung
                    </h3>

                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Ausrüsten: Rute</h4>
                        <div id="gear-rods-list" class="space-y-2"></div>
                    </div>

                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Ausrüsten: Köder</h4>
                        <div id="gear-baits-list" class="grid grid-cols-2 gap-2"></div>
                    </div>
                </div>

                <!-- FANGBUCH (LOG) TAB -->
                <div id="tab-log" class="tab-content hidden space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-2">
                        <h3 class="font-game text-lg text-emerald-400">
                            <i class="fa-solid fa-book-bookmark mr-2"></i>Fangbuch
                        </h3>
                        <span id="log-completion-stats" class="text-xs font-bold bg-slate-900 px-2 py-1 rounded-lg text-slate-300">0 / 0 Entdeckt</span>
                    </div>

                    <div id="fangbuch-list" class="space-y-2"></div>
                </div>

                <!-- LOCATIONS TAB -->
                <div id="tab-locations" class="tab-content hidden space-y-4">
                    <h3 class="font-game text-lg text-purple-400 border-b border-slate-700 pb-2">
                        <i class="fa-solid fa-compass mr-2"></i>Gewässer Wechseln
                    </h3>
                    <div id="locations-list" class="space-y-3"></div>
                </div>

            </div>
        </div>

    </div>

    <!-- JAVASCRIPT GAME ENGINE -->
    <script>
        // ==========================================
// GAME STATE & BALANCING (BALANCED MEDIUM EDITION)
// ==========================================
let state = {
    gold: 0,
    currentRod: 0,
    currentBait: 0,
    currentLocation: 0,
    unlockedLocations: [true, false, false],
    baitCounts: [Infinity, 10, 5, 2, 1], // Basic infinite, others limited
    stats: { totalCaught: 0, totalEarned: 0, biggestFish: 0 },
    logbook: {}
};

// RODS DEFINITION (Increased Prices for Longevity)
const RODS = [
    { name: "Holzstock", price: 0, power: 1.0, greenZoneBonus: 1.0, desc: "Eine einfache Weidenrute mit Faden." },
    { name: "Profi-Teleskop", price: 150, power: 1.25, greenZoneBonus: 1.1, desc: "Bessere Kontrolle bei unruhigen Fischen." },
    { name: "Carbon-Superfischer", price: 500, power: 1.55, greenZoneBonus: 1.2, desc: "Leicht, stark und stabil." },
    { name: "Titan-Meisterrute", price: 1500, power: 1.9, greenZoneBonus: 1.35, desc: "Dämpft Rucke großer Meeresungeheuer." },
    { name: "Magische Rute", price: 4000, power: 2.3, greenZoneBonus: 1.5, desc: "Magische Aura vergrößert das Fangfenster." },
    { name: "Neptuns Dreizack-Angel", price: 10000, power: 3.0, greenZoneBonus: 1.75, desc: "Legendäres Werkzeug der Ozeangötter." }
];

// BAITS DEFINITION (Rebalanced Costs)
const BAITS = [
    { name: "Teig / Brot", price: 0, packSize: Infinity, luckBonus: 1.0, desc: "Unendlich verfügbar. Zieht meist kleine Fische an." },
    { name: "Maden-Paket", price: 15, packSize: 10, luckBonus: 1.3, desc: "Beliebt bei Speisefischen. Erhöht die Ausbeute." },
    { name: "Wurm-Dose", price: 35, packSize: 10, luckBonus: 1.7, desc: "Klassiker für seltenere Fluss- und Seebewohner." },
    { name: "Blinker / Köderfisch", price: 80, packSize: 5, luckBonus: 2.3, desc: "Lockt Raubfische und größere Kaliber an." },
    { name: "Wunder-Garnelen", price: 180, packSize: 3, luckBonus: 3.5, desc: "Edelköder! Hohe Chance auf seltene & legendäre Fische." }
];

// LOCATIONS DEFINITION (Unlocks Increased to 500 G & 2500 G)
const LOCATIONS = [
    { id: 0, name: "Waldsee", unlockPrice: 0, bgClass: "bg-forest", difficulty: 1.0, desc: "Ruhiger See voller Anfängerfische." },
    { id: 1, name: "Bergsee", unlockPrice: 500, bgClass: "bg-mountain", difficulty: 1.35, desc: "Klares Gletscherwasser mit flinken Fischen." },
    { id: 2, name: "Ozean-Riff", unlockPrice: 2500, bgClass: "bg-ocean", difficulty: 1.8, desc: "Tiefer Ozean mit gigantischen Wellen und Meeresbestien." }
];

// FISH SPECIES & REDUCED PRICES (~40-50% Reduction for Rebalance)
const FISH_SPECIES = [
    // WALDSEE (Location 0)
    { id: "barsch", name: "Flussbarsch", loc: 0, rarity: "common", basePrice: 12, minSize: 15, maxSize: 35, speed: 1.1, icon: "🐟" },
    { id: "rotauge", name: "Rotauge", loc: 0, rarity: "common", basePrice: 10, minSize: 10, maxSize: 25, speed: 0.9, icon: "🐟" },
    { id: "schleie", name: "Schleie", loc: 0, rarity: "uncommon", basePrice: 28, minSize: 25, maxSize: 50, speed: 1.3, icon: "🐠" },
    { id: "hecht", name: "Hecht", loc: 0, rarity: "rare", basePrice: 65, minSize: 45, maxSize: 100, speed: 1.7, icon: "🐊" },
    { id: "karpfen_gold", name: "Gold-Karpfen", loc: 0, rarity: "legendary", basePrice: 220, minSize: 50, maxSize: 90, speed: 2.2, icon: "✨" },

    // BERGSEE (Location 1)
    { id: "forelle", name: "Regenbogenforelle", loc: 1, rarity: "common", basePrice: 22, minSize: 20, maxSize: 45, speed: 1.3, icon: "🐟" },
    { id: "saibling", name: "Seesaibling", loc: 1, rarity: "uncommon", basePrice: 42, minSize: 25, maxSize: 55, speed: 1.5, icon: "🐠" },
    { id: "aale", name: "Berg-Aal", loc: 1, rarity: "rare", basePrice: 95, minSize: 50, maxSize: 110, speed: 1.9, icon: "🐍" },
    { id: "lachs", name: "Königslachs", loc: 1, rarity: "rare", basePrice: 130, minSize: 60, maxSize: 120, speed: 2.1, icon: "🐟" },
    { id: "berg_könig", name: "Gletscher-Ur-Fisch", loc: 1, rarity: "legendary", basePrice: 380, minSize: 80, maxSize: 160, speed: 2.6, icon: "❄️" },

    // OZEAN (Location 2)
    { id: "makrele", name: "Makrele", loc: 2, rarity: "common", basePrice: 35, minSize: 25, maxSize: 45, speed: 1.5, icon: "🐟" },
    { id: "thunfisch", name: "Blauflossen-Thunfisch", loc: 2, rarity: "uncommon", basePrice: 85, minSize: 70, maxSize: 180, speed: 2.0, icon: "🐟" },
    { id: "schwertfisch", name: "Schwertfisch", loc: 2, rarity: "rare", basePrice: 190, minSize: 120, maxSize: 250, speed: 2.5, icon: "🗡️" },
    { id: "haifisch", name: "Mako-Hai", loc: 2, rarity: "rare", basePrice: 260, minSize: 150, maxSize: 300, speed: 2.8, icon: "🦈" },
    { id: "kraken", name: "Tiefsee-Kraken", loc: 2, rarity: "legendary", basePrice: 600, minSize: 200, maxSize: 500, speed: 3.3, icon: "🐙" }
];

// MINIGAME TUNING (MEDIUM BALANCED DIFFICULTY)
let minigame = {
    active: false,
    fishPos: 50,       // 0 to 100
    fishTarget: 50,
    fishVel: 0,
    greenPos: 35,      // Bottom position of green zone
    greenHeight: 29,   // ~29% height (Harder than 35%, easier than original 20%)
    tension: 0,        // 0 to 100
    progress: 25,      // 0 to 100
    currentFish: null,
    fishSize: 0,
    fishWeight: 0,
    fishValue: 0
};

                const handleActionEnd = () => {
function updateMinigameLogic() {
    if (!minigame.active) return;

    const rod = RODS[state.currentRod];
    const loc = LOCATIONS[state.currentLocation];

    // 1. DYNAMIC GREEN ZONE HEIGHT BASED ON ROD & FISH
    const effectiveGreenHeight = Math.min(50, minigame.greenHeight * rod.greenZoneBonus);

    // 2. FISH MOVEMENT AI (Natural Jitter & Rarity-based evasion)
    if (Math.random() < 0.05 * minigame.currentFish.speed) {
        // Change target location
        minigame.fishTarget = 15 + Math.random() * 70;
    }

    // Unpredictable bursts for rare/legendary
    if ((minigame.currentFish.rarity === 'rare' || minigame.currentFish.rarity === 'legendary') && Math.random() < 0.02) {
        minigame.fishTarget = Math.random() > 0.5 ? 85 : 15;
    }

    // Smooth physics towards target
    const targetDiff = minigame.fishTarget - minigame.fishPos;
    minigame.fishVel += targetDiff * 0.008 * minigame.currentFish.speed * loc.difficulty;
    minigame.fishVel *= 0.92; // Friction
    minigame.fishPos += minigame.fishVel;

    // Clamp fish within bar
    if (minigame.fishPos < 5) { minigame.fishPos = 5; minigame.fishVel = 0; }
    if (minigame.fishPos > 95) { minigame.fishPos = 95; minigame.fishVel = 0; }

    // 3. REEL / GREEN ZONE POSITIONING
    if (isReeling) {
        minigame.greenPos += 1.45 * rod.power;
    } else {
        minigame.greenPos -= 1.35;
    }

    // Clamp green zone
    if (minigame.greenPos < 0) minigame.greenPos = 0;
    if (minigame.greenPos > 100 - effectiveGreenHeight) minigame.greenPos = 100 - effectiveGreenHeight;

    // 4. CHECK IF FISH IS INSIDE GREEN ZONE
    const fishInZone = (minigame.fishPos >= minigame.greenPos) && 
                       (minigame.fishPos <= minigame.greenPos + effectiveGreenHeight);

    if (fishInZone) {
        // Progress gain (~0.3% to 0.4% per frame)
        minigame.progress += 0.32 * rod.power;
        // Tension relieves when fish is safe inside
        minigame.tension = Math.max(0, minigame.tension - 0.7);
    } else {
        // Moderate tension build rate (~0.38 per frame -> approx 3.5 - 4s leeway)
        minigame.tension += 0.38;
        // Progress drops slowly
        minigame.progress = Math.max(0, minigame.progress - 0.18);
    }

    // Render minigame UI updates
    const barHeight = 220; // Canvas/UI height of bar
    const greenPixelHeight = (effectiveGreenHeight / 100) * barHeight;
    const greenPixelBottom = (minigame.greenPos / 100) * barHeight;
    const fishPixelBottom = (minigame.fishPos / 100) * barHeight;

    if (ui.greenZone) {
        ui.greenZone.style.height = `${greenPixelHeight}px`;
        ui.greenZone.style.bottom = `${greenPixelBottom}px`;
        if (fishInZone) {
            ui.greenZone.classList.add('in-zone');
        } else {
            ui.greenZone.classList.remove('in-zone');
        }
    }

    if (ui.fishIcon) {
        ui.fishIcon.style.bottom = `${fishPixelBottom - 12}px`;
    }

    if (ui.tensionFill) {
        ui.tensionFill.style.height = `${minigame.tension}%`;
    }

    if (ui.progressFill) {
        ui.progressFill.style.width = `${minigame.progress}%`;
    }

    // Win / Lose Checks
    if (minigame.progress >= 100) {
        catchFishSuccess();
    } else if (minigame.tension >= 100) {
        catchFishFailed();
    }
}
                };

                this.canvas.addEventListener('mousedown', handleActionStart);
                this.canvas.addEventListener('mouseup', handleActionEnd);
                this.canvas.addEventListener('touchstart', (e) => { e.preventDefault(); handleActionStart(); }, { passive: false });
                this.canvas.addEventListener('touchend', (e) => { e.preventDefault(); handleActionEnd(); }, { passive: false });

                // UI Reeling Button
                const reelBtn = document.getElementById('reel-btn');
                reelBtn.addEventListener('mousedown', () => { this.isPulling = true; });
                reelBtn.addEventListener('mouseup', () => { this.isPulling = false; });
                reelBtn.addEventListener('touchstart', (e) => { e.preventDefault(); this.isPulling = true; }, { passive: false });
                reelBtn.addEventListener('touchend', (e) => { e.preventDefault(); this.isPulling = false; }, { passive: false });

                // Keyboard Controls (Spacebar)
                window.addEventListener('keydown', (e) => {
                    if (e.code === 'Space' && !e.repeat) {
                        handleActionStart();
                    }
                });
                window.addEventListener('keyup', (e) => {
                    if (e.code === 'Space') {
                        handleActionEnd();
                    }
                });
            }

            // ==========================================
            // GAMEPLAY FLOW & MECHANICS
            // ==========================================

            startCasting() {
                const baitCount = this.inventoryBaits[this.currentBaitId] || 0;
                if (baitCount <= 0) {
                    this.notify("Du hast keinen Köder mehr! Kaufe welchen im Shop.");
                    return;
                }

                this.state = 'CASTING';
                this.powerVal = 0;
                this.powerDir = 1;
                document.getElementById('power-bar-container').classList.remove('hidden');
            }

            executeCast() {
                this.state = 'WAITING';
                document.getElementById('power-bar-container').classList.add('hidden');

                // Deduct Bait
                this.inventoryBaits[this.currentBaitId]--;

                // Calculate Bobber landing coords
                const waterY = this.canvas.height * 0.55;
                const minX = this.canvas.width * 0.25;
                const maxX = this.canvas.width * 0.85;
                const castDist = minX + (maxX - minX) * (this.powerVal / 100);

                this.bobber.x = this.canvas.width * 0.15; // Start at angler
                this.bobber.y = this.canvas.height * 0.4;
                this.bobber.targetX = castDist;
                this.bobber.targetY = waterY + Math.random() * (this.canvas.height * 0.35);
                this.bobber.inWater = false;

                this.sound.playCast();

                // Animate Bobber Throw
                let progress = 0;
                const animateThrow = () => {
                    progress += 0.05;
                    this.bobber.x = this.canvas.width * 0.15 + (this.bobber.targetX - this.canvas.width * 0.15) * progress;
                    // Arc trajectory
                    const arc = Math.sin(progress * Math.PI) * 120;
                    this.bobber.y = (this.canvas.height * 0.4 + (this.bobber.targetY - this.canvas.height * 0.4) * progress) - arc;

                    if (progress < 1) {
                        requestAnimationFrame(animateThrow);
                    } else {
                        this.bobber.inWater = true;
                        this.sound.playSplash();
                        this.createSplash(this.bobber.x, this.bobber.y);
                        this.scheduleBite();
                    }
                };
                animateThrow();

                this.updateUI();
            }

            scheduleBite() {
                // Determine bite wait time based on rod and bait
                const baseWait = 3000 + Math.random() * 4000;
                this.biteTimer = setTimeout(() => {
                    if (this.state === 'WAITING') {
                        this.triggerBitePrompt();
                    }
                }, baseWait);
            }

            triggerBitePrompt() {
                this.state = 'BITING';
                this.sound.playBite();
                document.getElementById('bite-prompt').classList.remove('hidden');

                // Select Fish from current location based on bait
                const locFish = FISH_SPECIES.filter(f => f.location === this.currentLocationId);
                const baitDef = BAITS.find(b => b.id === this.currentBaitId);

                // Filter/Weight fish probabilities
                let candidates = locFish;
                this.currentHookedFish = candidates[Math.floor(Math.random() * candidates.length)];

                // Size & Weight generation
                const sizeRatio = Math.random();
                this.hookedFishSize = Math.round(this.currentHookedFish.minSize + (this.currentHookedFish.maxSize - this.currentHookedFish.minSize) * sizeRatio);
                this.hookedFishWeight = parseFloat((this.currentHookedFish.minWeight + (this.currentHookedFish.maxWeight - this.currentHookedFish.minWeight) * Math.pow(sizeRatio, 1.5)).toFixed(2));

                // Bite window (time player has to click)
                this.biteTimeout = setTimeout(() => {
                    if (this.state === 'BITING') {
                        this.resetToIdle("Der Fisch ist entkommen!");
                    }
                }, 1800);
            }

            triggerHook() {
                clearTimeout(this.biteTimeout);
                document.getElementById('bite-prompt').classList.add('hidden');
                this.state = 'REELING';

                // Balanced Minigame Parameters
                this.targetZoneY = 35;
                this.targetZoneHeight = 35; // Balanced size (35% height)
                this.fishIconY = 50;
                this.tension = 10;
                this.fishVelocity = 0;

                document.getElementById('minigame-container').classList.remove('hidden');
            }

            updateMinigame(delta) {
                if (this.state !== 'REELING') return;

                const rod = RODS.find(r => r.id === this.currentRodId);
                const fish = this.currentHookedFish;

                // Balanced Fish Movement AI
                if (Math.random() < 0.05) {
                    this.fishVelocity = (Math.random() - 0.5) * (1.8 * (fish.diff * 0.7));
                }
                this.fishIconY += this.fishVelocity;
                this.fishIconY = Math.max(5, Math.min(95, this.fishIconY));

                // Target zone movement with smooth physics
                if (this.isPulling) {
                    this.targetZoneY -= (1.6 * rod.reelSpeed);
                } else {
                    this.targetZoneY += 1.3;
                }
                this.targetZoneY = Math.max(0, Math.min(100 - this.targetZoneHeight, this.targetZoneY));

                // Check overlap
                const targetZoneTop = this.targetZoneY;
                const targetZoneBottom = this.targetZoneY + this.targetZoneHeight;
                const isInside = (this.fishIconY >= targetZoneTop && this.fishIconY <= targetZoneBottom);

                if (isInside) {
                    // Reduce tension steadily when inside green area
                    this.tension = Math.max(0, this.tension - 0.5);
                    this.bobber.x -= (0.8 * rod.reelSpeed);
                } else {
                    // Moderate tension increase when outside
                    const diffPenalty = (fish.diff / rod.power) * 0.32;
                    this.tension += diffPenalty;
                    this.bobber.x -= (0.1 * rod.reelSpeed);
                }

                // UI Updates
                const targetEl = document.getElementById('target-zone');
                const fishEl = document.getElementById('fish-icon');
                const tensionBar = document.getElementById('tension-bar-fill');
                const tensionText = document.getElementById('tension-text');
                const tensionPercent = document.getElementById('tension-percent');

                targetEl.style.top = `${this.targetZoneY}%`;
                targetEl.style.height = `${this.targetZoneHeight}%`;
                fishEl.style.top = `${this.fishIconY}%`;

                const tensionRounded = Math.round(this.tension);
                tensionBar.style.width = `${tensionRounded}%`;
                tensionPercent.textContent = `${tensionRounded}%`;

                if (tensionRounded > 80) {
                    tensionBar.className = 'h-full bg-red-500 transition-all duration-100';
                    tensionText.textContent = 'GEFAHR!';
                    tensionText.className = 'text-red-400 font-bold animate-pulse';
                } else if (tensionRounded > 50) {
                    tensionBar.className = 'h-full bg-amber-500 transition-all duration-100';
                    tensionText.textContent = 'SPANNUNG HOCH';
                    tensionText.className = 'text-amber-400';
                } else {
                    tensionBar.className = 'h-full bg-emerald-500 transition-all duration-100';
                    tensionText.textContent = 'GUT!';
                    tensionText.className = 'text-emerald-400 font-bold';
                }

                // Check Snap
                if (this.tension >= 100) {
                    this.sound.playLineSnap();
                    this.resetToIdle("Die Angelschnur ist gerissen!");
                    return;
                }

                // Check Catch Complete
                if (this.bobber.x <= this.canvas.width * 0.2) {
                    this.completeCatch();
                }
            }

            completeCatch() {
                this.state = 'RESULT';
                document.getElementById('minigame-container').classList.add('hidden');

                const fish = this.currentHookedFish;
                const valueMultiplier = (this.hookedFishSize / fish.maxSize);
                const finalCoins = Math.round(fish.baseValue * (0.8 + valueMultiplier * 0.5));
                const finalXp = Math.round(fish.xp * (0.8 + valueMultiplier * 0.4));

                // Add Rewards
                this.coins += finalCoins;
                this.addXP(finalXp);

                // Record in Fangbuch
                if (!this.catchLog[fish.id]) {
                    this.catchLog[fish.id] = { count: 0, maxCm: 0, maxKg: 0 };
                }
                this.catchLog[fish.id].count++;
                if (this.hookedFishSize > this.catchLog[fish.id].maxCm) this.catchLog[fish.id].maxCm = this.hookedFishSize;
                if (this.hookedFishWeight > this.catchLog[fish.id].maxKg) this.catchLog[fish.id].maxKg = this.hookedFishWeight;

                this.sound.playSuccess();
                this.saveGame();

                // Populate Catch Modal
                const modal = document.getElementById('catch-modal');
                const rarityBadge = document.getElementById('catch-rarity-badge');
                rarityBadge.textContent = fish.rarity;
                rarityBadge.className = `inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest font-bold mb-2 badge-${fish.rarity.toLowerCase()}`;

                document.getElementById('catch-fish-name').textContent = `${fish.icon} ${fish.name}`;
                document.getElementById('catch-fish-desc').textContent = fish.desc;
                document.getElementById('catch-fish-size').textContent = `${this.hookedFishSize} cm`;
                document.getElementById('catch-fish-weight').textContent = `${this.hookedFishWeight} kg`;
                document.getElementById('catch-fish-value').textContent = `+${finalCoins} Münzen`;
                document.getElementById('catch-fish-xp').textContent = `+${finalXp} XP`;

                modal.classList.remove('hidden');
            }

            closeCatchModal() {
                document.getElementById('catch-modal').classList.add('hidden');
                this.resetToIdle();
            }

            resetToIdle(msg = null) {
                this.state = 'IDLE';
                clearTimeout(this.biteTimer);
                clearTimeout(this.biteTimeout);

                document.getElementById('power-bar-container').classList.add('hidden');
                document.getElementById('bite-prompt').classList.add('hidden');
                document.getElementById('minigame-container').classList.add('hidden');

                this.bobber.inWater = false;
                if (msg) this.notify(msg);
                this.updateUI();
            }

            addXP(amount) {
                this.xp += amount;
                const xpNeeded = this.level * 100;
                if (this.xp >= xpNeeded) {
                    this.xp -= xpNeeded;
                    this.level++;
                    this.notify(`LEVEL UP! Du bist jetzt Level ${this.level}!`);
                }
            }

