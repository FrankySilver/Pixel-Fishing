<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pfad des Anglers - Episches 2D Pixelart Angel-RPG</title>
    <!-- Tailwind CSS for modern responsive UI overlays -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Pixel / Retro style -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090d16;
            color: #f3f4f6;
            overflow: hidden;
            user-select: none;
        }
        .pixel-font {
            font-family: 'Press Start 2P', monospace;
        }
        /* Custom scrollbar for inventory and quest logs */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        canvas {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }
        .retro-box {
            border: 4px solid #334155;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
            background: rgba(15, 23, 42, 0.95);
        }
        .retro-btn {
            border: 3px solid #64748b;
            box-shadow: inset 0 2px 0 rgba(255,255,255,0.2), 0 4px 0 #0f172a;
            transition: all 0.1s ease;
        }
        .retro-btn:hover {
            transform: translateY(-2px);
            box-shadow: inset 0 2px 0 rgba(255,255,255,0.3), 0 6px 0 #0f172a;
            border-color: #94a3b8;
        }
        .retro-btn:active {
            transform: translateY(2px);
            box-shadow: inset 0 1px 0 rgba(0,0,0,0.3), 0 1px 0 #0f172a;
        }
    </style>
</head>
<body class="w-screen h-screen flex flex-col justify-between relative">

    <!-- Main UI Container -->
    <div id="app" class="w-full h-full relative flex flex-col items-center justify-center">

        <!-- BACKGROUND MUSIC & AUDIO CONTAINER (Hidden Youtube Player wrapper & synthesized web audio) -->
        <div id="audio-container" class="hidden">
            <iframe id="yt-player" width="1" height="1" src="https://www.youtube.com/embed/ByGhsipzw0I?enablejsapi=1&autoplay=1&loop=1&playlist=ByGhsipzw0I" allow="autoplay"></iframe>
        </div>

        <!-- SCREEN 1: MAIN MENU -->
        <div id="screen-main-menu" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-slate-950 bg-cover bg-center" style="background: linear-gradient(rgba(5, 10, 25, 0.85), rgba(5, 10, 25, 0.95)), url('https://placehold.co/1920x1080/0f172a/38bdf8?text=Pfad+des+Anglers') center/cover;">
            <div class="text-center mb-8 px-4">
                <h1 class="pixel-font text-4xl md:text-6xl text-emerald-400 mb-4 drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)]">PFAD DES ANGLERS</h1>
                <p class="text-slate-400 text-sm md:text-lg">Ein episches 2D Pixelart Angel-Abenteuer über 5 Gewässer</p>
            </div>

            <div class="flex flex-col gap-4 w-72 md:w-80">
                <button onclick="Game.startNewGameSetup()" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font py-4 px-6 text-xs md:text-sm rounded flex items-center justify-center gap-3">
                    <i class="fa-solid fa-fish"><span>Neues Spiel</span></i>
                </button>
                <button id="btn-continue" onclick="Game.loadGame()" class="retro-btn bg-sky-600 hover:bg-sky-500 text-white pixel-font py-4 px-6 text-xs md:text-sm rounded flex items-center justify-center gap-3 opacity-50 cursor-not-allowed" disabled>
                    <i class="fa-solid fa-play"><span>Spiel fortsetzen</span></i>
                </button>
                <button onclick="Game.openSettings()" class="retro-btn bg-slate-700 hover:bg-slate-600 text-white pixel-font py-4 px-6 text-xs md:text-sm rounded flex items-center justify-center gap-3">
                    <i class="fa-solid fa-gear"><span>Einstellungen</span></i>
                </button>
            </div>
            
            <div class="absolute bottom-4 text-slate-500 text-xs pixel-font">
                v1.0.0 &bull; Pixelart Edition &bull; GitHub Pages Ready
            </div>
        </div>

        <!-- SCREEN 2: CHARACTER CREATION -->
        <div id="screen-char-create" class="absolute inset-0 z-50 hidden flex-col items-center justify-center bg-slate-950 p-6 overflow-y-auto">
            <div class="retro-box p-6 md:p-8 rounded-xl max-w-2xl w-full flex flex-col gap-6">
                <h2 class="pixel-font text-xl text-emerald-400 text-center">Charaktererstellung</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <!-- Preview Canvas -->
                    <div class="flex flex-col items-center justify-center bg-slate-900 p-4 rounded-lg border-2 border-slate-700">
                        <canvas id="char-preview-canvas" width="128" height="128" class="w-32 h-32 bg-slate-950 rounded mb-4 shadow-inner"></canvas>
                        <div class="w-full">
                            <label class="block text-xs text-slate-400 pixel-font mb-2">Name des Anglers:</label>
                            <input type="text" id="char-name-input" value="Masterangler" class="w-full bg-slate-800 border-2 border-slate-600 rounded px-3 py-2 text-white focus:outline-none focus:border-emerald-500 pixel-font text-xs" maxlength="15">
                        </div>
                    </div>

                    <!-- Customization Options -->
                    <div class="flex flex-col gap-4">
                        <div>
                            <label class="block text-xs text-slate-400 pixel-font mb-1">Geschlecht:</label>
                            <div class="grid grid-cols-2 gap-2">
                                <button onclick="Game.setGender('male')" id="btn-gender-male" class="retro-btn bg-emerald-600 text-white pixel-font py-2 px-3 text-xs rounded">Männlich</button>
                                <button onclick="Game.setGender('female')" id="btn-gender-female" class="retro-btn bg-slate-800 text-white pixel-font py-2 px-3 text-xs rounded">Weiblich</button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-400 pixel-font mb-1">Haarstil (<span id="lbl-hair">1</span>/5):</label>
                            <div class="flex justify-between items-center bg-slate-800 p-2 rounded border border-slate-700">
                                <button onclick="Game.changeCustom('hair', -1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&lt;</button>
                                <span id="val-hair" class="pixel-font text-xs">Stil 1</span>
                                <button onclick="Game.changeCustom('hair', 1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&gt;</button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-400 pixel-font mb-1">Hut (<span id="lbl-hat">1</span>/5):</label>
                            <div class="flex justify-between items-center bg-slate-800 p-2 rounded border border-slate-700">
                                <button onclick="Game.changeCustom('hat', -1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&lt;</button>
                                <span id="val-hat" class="pixel-font text-xs">Keiner / Hut 1</span>
                                <button onclick="Game.changeCustom('hat', 1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&gt;</button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-400 pixel-font mb-1">Klamotten (<span id="lbl-clothes">1</span>/5):</label>
                            <div class="flex justify-between items-center bg-slate-800 p-2 rounded border border-slate-700">
                                <button onclick="Game.changeCustom('clothes', -1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&lt;</button>
                                <span id="val-clothes" class="pixel-font text-xs">Stil 1</span>
                                <button onclick="Game.changeCustom('clothes', 1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&gt;</button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-400 pixel-font mb-1">Stiefel (<span id="lbl-boots">1</span>/5):</label>
                            <div class="flex justify-between items-center bg-slate-800 p-2 rounded border border-slate-700">
                                <button onclick="Game.changeCustom('boots', -1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&lt;</button>
                                <span id="val-boots" class="pixel-font text-xs">Stil 1</span>
                                <button onclick="Game.changeCustom('boots', 1)" class="retro-btn bg-slate-700 px-3 py-1 rounded text-xs">&gt;</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between gap-4 mt-4">
                    <button onclick="Game.returnToMainMenu()" class="retro-btn bg-slate-700 hover:bg-slate-600 text-white pixel-font py-3 px-6 text-xs rounded">Zurück</button>
                    <button onclick="Game.finishCharacterCreation()" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font py-3 px-6 text-xs rounded">Abenteuer starten!</button>
                </div>
            </div>
        </div>

        <!-- SCREEN 3: SETTINGS -->
        <div id="screen-settings" class="absolute inset-0 z-50 hidden flex-col items-center justify-center bg-slate-950 p-6">
            <div class="retro-box p-8 rounded-xl max-w-md w-full flex flex-col gap-6">
                <h2 class="pixel-font text-xl text-emerald-400 text-center">Einstellungen</h2>
                
                <div class="flex flex-col gap-4">
                    <div>
                        <label class="block text-xs text-slate-300 pixel-font mb-2 flex justify-between">
                            <span>Musik Lautstärke</span>
                            <span id="val-music-vol">50%</span>
                        </label>
                        <input type="range" id="range-music-vol" min="0" max="100" value="50" oninput="Game.updateVolume('music', this.value)" class="w-full accent-emerald-500 bg-slate-800 rounded">
                    </div>

                    <div>
                        <label class="block text-xs text-slate-300 pixel-font mb-2 flex justify-between">
                            <span>Soundeffekte</span>
                            <span id="val-sfx-vol">80%</span>
                        </label>
                        <input type="range" id="range-sfx-vol" min="0" max="100" value="80" oninput="Game.updateVolume('sfx', this.value)" class="w-full accent-emerald-500 bg-slate-800 rounded">
                    </div>

                    <div class="pt-4 border-t border-slate-700">
                        <h3 class="pixel-font text-xs text-sky-400 mb-2">Tastensteuerung & Hilfe</h3>
                        <div class="text-xs text-slate-300 space-y-1 font-mono bg-slate-900 p-3 rounded border border-slate-800">
                            <p><b>W, A, S, D</b> - Bewegen</p>
                            <p><b>I</b> - Angelkoffer / Inventar öffnen</p>
                            <p><b>Linksklick</b> - Auswerfen / Anschlagen / Einholen</p>
                            <p><b>Minispiel</b> - WASD Tasten drücken im Drill</p>
                            <p><b>ESC / Menü</b> - Spiel pausieren</p>
                        </div>
                    </div>
                </div>

                <button onclick="Game.closeSettings()" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font py-3 px-6 text-xs rounded w-full mt-2">Zurück</button>
            </div>
        </div>

        <!-- SCREEN 4: GAMEPLAY MAP & UI -->
        <div id="screen-game" class="absolute inset-0 hidden flex flex-col">
            <!-- Top HUD Bar -->
            <div class="bg-slate-900 border-b-4 border-slate-800 px-4 py-2 flex flex-wrap justify-between items-center z-20 shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 bg-slate-800 px-3 py-1 rounded border border-slate-700">
                        <i class="fa-solid fa-map-location-dot text-emerald-400"></i>
                        <span id="hud-map-name" class="pixel-font text-xs text-emerald-300">Stille Aue</span>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-800 px-3 py-1 rounded border border-slate-700">
                        <i class="fa-solid fa-coins text-amber-400"></i>
                        <span id="hud-money" class="pixel-font text-xs text-amber-300">100 Gold</span>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-800 px-3 py-1 rounded border border-slate-700">
                        <i class="fa-solid fa-star text-purple-400"></i>
                        <span id="hud-level" class="pixel-font text-xs text-purple-300">Lv. 1 (0 XP)</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button onclick="Game.openInventory()" class="retro-btn bg-slate-800 hover:bg-slate-700 text-white pixel-font px-3 py-2 text-xs rounded flex items-center gap-2">
                        <i class="fa-solid fa-briefcase text-sky-400"></i><span>Angelkoffer (I)</span>
                    </button>
                    <button onclick="Game.openFishBook()" class="retro-btn bg-slate-800 hover:bg-slate-700 text-white pixel-font px-3 py-2 text-xs rounded flex items-center gap-2">
                        <i class="fa-solid fa-book text-emerald-400"></i><span>Fischbuch</span>
                    </button>
                    <button onclick="Game.openQuests()" class="retro-btn bg-slate-800 hover:bg-slate-700 text-white pixel-font px-3 py-2 text-xs rounded flex items-center gap-2 relative">
                        <i class="fa-solid fa-scroll text-amber-400"></i><span>Quests</span>
                        <span id="quest-badge" class="absolute -top-1 -right-1 bg-red-500 text-white rounded-full w-4 h-4 text-[9px] flex items-center justify-center pixel-font hidden">!</span>
                    </button>
                    <button onclick="Game.openSkills()" class="retro-btn bg-slate-800 hover:bg-slate-700 text-white pixel-font px-3 py-2 text-xs rounded flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-pink-400"></i><span>Skills</span>
                    </button>
                    <button onclick="Game.openMapSelect()" class="retro-btn bg-indigo-700 hover:bg-indigo-600 text-white pixel-font px-3 py-2 text-xs rounded flex items-center gap-2">
                        <i class="fa-solid fa-globe text-white"></i><span>Gewässer</span>
                    </button>
                    <button onclick="Game.openSettings()" class="retro-btn bg-slate-800 hover:bg-slate-700 text-white pixel-font px-3 py-2 text-xs rounded">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>
            </div>

            <!-- Main Canvas Viewport for 2D RPG World -->
            <div id="canvas-container" class="flex-1 relative bg-slate-950 overflow-hidden cursor-crosshair">
                <canvas id="game-canvas" class="w-full h-full block"></canvas>

                <!-- Floating Interaction Tooltip (e.g., "Drücke E zum Angeln / Händler sprechen") -->
                <div id="interaction-tooltip" class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/90 border-2 border-emerald-500 px-4 py-2 rounded-lg pixel-font text-xs text-emerald-300 shadow-lg hidden pointer-events-none flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-amber-400 animate-pulse"></i>
                    <span id="tooltip-text">Drücke Klick am Ufer zum Angeln!</span>
                </div>

                <!-- FISHING OVERLAY / CASTING METER & DRILL MINIGAME -->
                <div id="fishing-overlay" class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px] hidden flex flex-col items-center justify-center p-4">
                    <!-- Casting Bar State -->
                    <div id="casting-box" class="retro-box p-6 rounded-xl flex flex-col items-center gap-4 max-w-sm w-full">
                        <h3 class="pixel-font text-sm text-emerald-400">Auswerfen (Wurfweite)</h3>
                        <p class="text-xs text-slate-300 text-center">Klicke im grünen Bereich, um die Rute auszuwerfen!</p>
                        
                        <div class="w-full bg-slate-900 h-8 rounded-lg border-2 border-slate-700 relative overflow-hidden">
                            <div id="casting-target-zone" class="absolute h-full bg-emerald-500/40 border-x-2 border-emerald-400" style="left: 60%; width: 25%;"></div>
                            <div id="casting-cursor" class="absolute top-0 bottom-0 w-2 bg-white shadow-[0_0_10px_white]" style="left: 0%;"></div>
                        </div>

                        <button onclick="FishingGame.confirmCast()" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font py-3 px-6 text-xs rounded w-full">Auswerfen!</button>
                    </div>

                    <!-- Waiting for Bite State -->
                    <div id="waiting-box" class="retro-box p-6 rounded-xl flex flex-col items-center gap-4 max-w-sm w-full hidden">
                        <h3 class="pixel-font text-sm text-sky-400 animate-pulse">Warte auf Biss...</h3>
                        <div class="w-16 h-16 bg-slate-900 rounded-full border-2 border-slate-700 flex items-center justify-center text-2xl">
                            <i class="fa-solid fa-water text-sky-500 animate-bounce"></i>
                        </div>
                        <p class="text-xs text-slate-400 text-center">Beobachte den Schwimmer im Wasser! Bei Ausrufezeichen schnell mit Linksklick anschlagen!</p>
                        <button onclick="FishingGame.cancelFishing()" class="retro-btn bg-red-700 hover:bg-red-600 text-white pixel-font py-2 px-4 text-xs rounded">Abbrechen</button>
                    </div>

                    <!-- Drill / Combat Minigame State -->
                    <div id="drill-box" class="retro-box p-6 rounded-xl flex flex-col gap-4 max-w-md w-full hidden">
                        <div class="flex justify-between items-center">
                            <h3 class="pixel-font text-xs text-amber-400"><i class="fa-solid fa-fish-fins"></i> Fisch im Drill!</h3>
                            <span id="drill-fish-name" class="pixel-font text-xs text-white">Rotauge (1.2 kg)</span>
                        </div>

                        <!-- Fish Stamina Bar -->
                        <div>
                            <div class="flex justify-between text-[10px] text-slate-400 mb-1 pixel-font">
                                <span>Fisch Ausdauer</span>
                                <span id="drill-stamina-text">100%</span>
                            </div>
                            <div class="w-full bg-slate-900 h-4 rounded border border-slate-700 overflow-hidden">
                                <div id="drill-stamina-bar" class="h-full bg-red-500 transition-all duration-100" style="width: 100%;"></div>
                            </div>
                        </div>

                        <!-- Tension Bar -->
                        <div>
                            <div class="flex justify-between text-[10px] text-slate-400 mb-1 pixel-font">
                                <span>Schnur-Spannung</span>
                                <span id="drill-tension-text">Sicher</span>
                            </div>
                            <div class="w-full bg-slate-900 h-3 rounded border border-slate-700 overflow-hidden relative">
                                <div id="drill-tension-bar" class="h-full bg-emerald-500 transition-all duration-75" style="width: 30%;"></div>
                            </div>
                        </div>

                        <!-- WASD QTE Prompt Box -->
                        <div id="drill-qte-container" class="bg-slate-900 p-3 rounded border border-slate-700 flex flex-col items-center gap-2 hidden">
                            <span class="text-[10px] text-amber-300 pixel-font">Fisch kämpft wild! Drücke Tasten:</span>
                            <div id="drill-qte-keys" class="flex gap-2">
                                <span class="bg-slate-800 border border-slate-600 px-3 py-1 rounded pixel-font text-xs text-white">W</span>
                            </div>
                        </div>

                        <p class="text-[11px] text-slate-300 text-center">Halte Linksklick zum Einholen, wenn der Fisch müde ist! Achtung vor Schnurspannung!</p>
                        
                        <button onmousedown="FishingGame.startReeling()" onmouseup="FishingGame.stopReeling()" ontouchstart="FishingGame.startReeling()" ontouchend="FishingGame.stopReeling()" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font py-3 px-4 text-xs rounded w-full">
                            EINHOLEN (Halten)
                        </button>
                    </div>
                </div>
            </div>

            <!-- MODAL: INVENTORY / ANGELKOFFER -->
            <div id="modal-inventory" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
                <div class="retro-box p-6 rounded-xl max-w-4xl w-full flex flex-col gap-4 max-h-[90vh]">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                        <h2 class="pixel-font text-lg text-sky-400"><i class="fa-solid fa-briefcase"></i> Angelkoffer & Kescher</h2>
                        <button onclick="Game.closeModals()" class="text-slate-400 hover:text-white pixel-font text-sm"><i class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 overflow-y-auto pr-2">
                        <!-- Equipment / Bait & Tackle Slots -->
                        <div class="flex flex-col gap-4">
                            <h3 class="pixel-font text-xs text-emerald-400">Ausrüstung & Köder</h3>
                            <div class="bg-slate-900 p-4 rounded-lg border border-slate-800 space-y-3">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-slate-400">Aktuelle Rute:</span>
                                    <span id="inv-current-rod" class="pixel-font text-white">Bambusangel (Stufe 1)</span>
                                </div>
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-slate-400">Aktuelles Messer:</span>
                                    <span id="inv-current-knife" class="pixel-font text-white">Kein Messer</span>
                                </div>
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-slate-400">Aktiver Köder:</span>
                                    <span id="inv-active-bait" class="pixel-font text-amber-300">Brotwürfel (12 Stk)</span>
                                </div>
                            </div>

                            <h3 class="pixel-font text-xs text-emerald-400 mt-2">Köder-Auswahl</h3>
                            <div id="inv-baits-list" class="grid grid-cols-2 gap-2 max-h-40 overflow-y-auto">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <!-- Kescher / Fish Net (Up to 25 fish) & General Inventory (24 slots) -->
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center">
                                <h3 class="pixel-font text-xs text-sky-400">Kescher (Netz: <span id="net-count">0</span>/25 Fische)</h3>
                                <button onclick="Game.sellAllFish()" class="retro-btn bg-amber-600 hover:bg-amber-500 text-white pixel-font px-3 py-1 text-[10px] rounded">Alle beim Händler verkaufen</button>
                            </div>
                            <div id="net-fish-list" class="grid grid-cols-5 gap-2 bg-slate-900 p-3 rounded-lg border border-slate-800 min-h-[160px] max-h-[220px] overflow-y-auto">
                                <!-- Populated dynamically -->
                            </div>

                            <h3 class="pixel-font text-xs text-purple-400 mt-2">Inventar (24 Plätze)</h3>
                            <div id="inventory-grid" class="grid grid-cols-6 gap-2 bg-slate-900 p-3 rounded-lg border border-slate-800 max-h-[160px] overflow-y-auto">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end pt-3 border-t border-slate-700">
                        <button onclick="Game.closeModals()" class="retro-btn bg-slate-700 hover:bg-slate-600 text-white pixel-font py-2 px-6 text-xs rounded">Schließen</button>
                    </div>
                </div>
            </div>

            <!-- MODAL: FISH BOOK (ENZYKLOPÄDIE) -->
            <div id="modal-fishbook" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
                <div class="retro-box p-6 rounded-xl max-w-3xl w-full flex flex-col gap-4 max-h-[85vh]">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-3">
