                const xpPct = Math.min(100, (this.xp / xpNeeded) * 100);
                document.getElementById('xp-bar').style.width = `${xpPct}%`;

                const loc = LOCATIONS.find(l => l.id === this.currentLocationId);
                document.getElementById('location-name-hdr').textContent = loc.name;

                this.renderShop();
                this.renderGear();
                this.renderLog();
                this.renderLocations();
            }

