<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pixel-Fishing - Pfad des Helden</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #111;
            color: #fff;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }
        #game-container {
            position: relative;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
            border: 4px solid #444;
            background-color: #222;
        }
        canvas {
            display: block;
            background: #1a4c21;
        }
        .ui-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.85);
            z-index: 10;
        }
        h1 {
            color: #4CAF50;
            margin-bottom: 20px;
            text-shadow: 2px 2px #000;
        }
        button {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 12px 24px;
            margin: 8px;
            font-size: 18px;
            font-family: inherit;
            cursor: pointer;
            border-radius: 4px;
            box-shadow: 0 4px #2e7d32;
            transition: 0.1s;
        }
        button:hover {
            background-color: #45a049;
        }
        button:active {
            transform: translateY(4px);
            box-shadow: 0 0 #2e7d32;
        }
        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <div id="game-container">
        <!-- Hauptmenü -->
        <div id="main-menu" class="ui-overlay">
            <h1>PIXEL-FISHING</h1>
            <button onclick="startGame()">Neues Spiel</button>
            <button onclick="loadGame()">Spiel Fortsetzen</button>
            <button onclick="openSettings()">Einstellungen</button>
        </div>

        <!-- Einstellungen -->
        <div id="settings-menu" class="ui-overlay hidden">
            <h1>Einstellungen</h1>
            <p>Musik Lautstärke:</p>
            <input type="range" id="music-vol" min="0" max="100" value="50">
            <p>Sound Effekte:</p>
            <input type="range" id="sfx-vol" min="0" max="100" value="80">
            <br><br>
            <button onclick="closeSettings()">Zurück</button>
        </div>

        <!-- Das eigentliche Spiel Canvas -->
        <canvas id="gameCanvas" width="800" height="600"></canvas>
    </div>

    <!-- Hintergrundmusik (YouTube eingebunden) -->
    <iframe id="bg-audio" width="0" height="0" src="https://www.youtube.com/embed/ByGhsipzw0I?enablejsapi=1&autoplay=1&loop=1" allow="autoplay" style="display:none;"></iframe>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        let gameStarted = false;

        // Spieler-Objekt
        let player = {
            x: 400,
            y: 300,
            speed: 3,
            size: 20,
            color: "#3498db"
        };

        let keys = {};

        window.addEventListener("keydown", (e) => { keys[e.key.toLowerCase()] = true; });
        window.addEventListener("keyup", (e) => { keys[e.key.toLowerCase()] = false; });

        function startGame() {
            document.getElementById("main-menu").classList.add("hidden");
            gameStarted = true;
            loop();
        }

        function loadGame() {
            alert("Kein Speicherstand gefunden!");
        }

        function openSettings() {
            document.getElementById("main-menu").classList.add("hidden");
            document.getElementById("settings-menu").classList.remove("hidden");
        }

        function closeSettings() {
            document.getElementById("settings-menu").classList.add("hidden");
            document.getElementById("main-menu").classList.remove("hidden");
        }

        function update() {
            if (!gameStarted) return;

            // WASD Bewegung
            if (keys['w'] || keys['W']) player.y -= player.speed;
            if (keys['s'] || keys['S']) player.y += player.speed;
            if (keys['a'] || keys['A']) player.x -= player.speed;
            if (keys['d'] || keys['D']) player.x += player.speed;

            // Begrenzung am Bildschirmrand
            if (player.x < 0) player.x = 0;
            if (player.x > canvas.width - player.size) player.x = canvas.width - player.size;
            if (player.y < 0) player.y = 0;
            if (player.y > canvas.height - player.size) player.y = canvas.height - player.size;
        }

        function draw() {
            // Hintergrund (Wiese / See)
            ctx.fillStyle = "#2ecc71";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Blauer See in der Mitte
            ctx.fillStyle = "#2980b9";
            ctx.fillRect(100, 100, 250, 400);

            if (gameStarted) {
                // Spieler zeichnen
                ctx.fillStyle = player.color;
                ctx.fillRect(player.x, player.y, player.size, player.size);

                // UI Text im Spiel
                ctx.fillStyle = "#ffffff";
                ctx.font = "16px Courier New";
                ctx.fillText("Gewässer: Dorfteich | Steuerung: WASD zum Laufen", 20, 30);
            }
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }
    </script>
</body>
</html>
