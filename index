            buyRod(rodId) {
                const rod = RODS.find(r => r.id === rodId);
                if (this.coins >= rod.price && !this.inventoryRods.includes(rodId)) {
                    this.coins -= rod.price;
                    this.inventoryRods.push(rodId);
                    this.currentRodId = rodId;
                    this.saveGame();
                    this.updateUI();
                    this.notify(`${rod.name} gekauft und ausgerüstet!`);
                } else {
                    this.notify("Nicht genügend Münzen!");
                }
            }

            buyBait(baitId) {
                const bait = BAITS.find(b => b.id === baitId);
                if (this.coins >= bait.price) {
                    this.coins -= bait.price;
                    this.inventoryBaits[baitId] = (this.inventoryBaits[baitId] || 0) + bait.amount;
                    this.saveGame();
                    this.updateUI();
                    this.notify(`${bait.amount}x ${bait.name} gekauft!`);
                } else {
                    this.notify("Nicht genügend Münzen!");
                }
            }

            equipRod(rodId) {
                this.currentRodId = rodId;
                this.updateUI();
                this.notify("Angelrute gewechselt.");
            }

            equipBait(baitId) {
                this.currentBaitId = baitId;
                this.updateUI();
                this.notify("Köder gewechselt.");
            }

            switchLocation(locId) {
                if (this.state !== 'IDLE') return;
                this.currentLocationId = locId;
                this.spawnAmbientShadows();
                this.updateUI();
                this.notify("Gewässer gewechselt!");
            }

            switchTab(tabName) {
                document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
                document.querySelectorAll('.tab-btn').forEach(el => {
                    el.classList.remove('bg-slate-800', 'text-amber-400');
                    el.classList.add('text-slate-400');
                });

                document.getElementById(`tab-${tabName}`).classList.remove('hidden');
                const btn = document.getElementById(`tab-btn-${tabName}`);
                btn.classList.add('bg-slate-800', 'text-amber-400');
                btn.classList.remove('text-slate-400');
            }

            toggleSound() {
                this.sound.enabled = !this.sound.enabled;
                const icon = document.getElementById('sound-icon');
                icon.className = this.sound.enabled ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark text-red-400';
            }

            notify(text) {
                const toast = document.createElement('div');
                toast.className = 'fixed top-16 left-1/2 -translate-x-1/2 bg-slate-800/95 text-slate-100 border border-slate-700 px-4 py-2 rounded-2xl shadow-2xl z-50 text-xs font-bold animate-bounce pointer-events-none';
                toast.textContent = text;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 2200);
            }

            // ==========================================
            // CANVAS GRAPHICS & ANIMATION LOOP
            // ==========================================

            spawnAmbientShadows() {
                this.fishShadows = [];
                for (let i = 0; i < 6; i++) {
                    this.fishShadows.push({
                        x: Math.random() * this.canvas.width,
                        y: this.canvas.height * (0.6 + Math.random() * 0.35),
                        speed: 0.3 + Math.random() * 0.8,
                        size: 15 + Math.random() * 25,
                        dir: Math.random() > 0.5 ? 1 : -1
                    });
                }
            }

            createSplash(x, y) {
                for (let i = 0; i < 12; i++) {
                    this.particles.push({
                        x: x,
                        y: y,
                        vx: (Math.random() - 0.5) * 4,
                        vy: -2 - Math.random() * 4,
                        radius: 2 + Math.random() * 3,
                        alpha: 1
                    });
                }
            }

            loop(timestamp) {
                this.update(timestamp);
                this.draw();
                requestAnimationFrame((t) => this.loop(t));
            }

            update(timestamp) {
                this.waveOffset += 0.03;

                // Power Bar Oscillation
                if (this.state === 'CASTING') {
                    this.powerVal += this.powerDir * 2.2;
                    if (this.powerVal >= 100) { this.powerVal = 100; this.powerDir = -1; }
                    if (this.powerVal <= 0) { this.powerVal = 0; this.powerDir = 1; }
                    document.getElementById('power-bar-fill').style.width = `${this.powerVal}%`;
                }

                // Update Reeling Physics
                if (this.state === 'REELING') {
                    this.updateMinigame();
                }

                // Update Ambient Fish Shadows
                this.fishShadows.forEach(s => {
                    s.x += s.speed * s.dir;
                    if (s.x > this.canvas.width + 50) s.x = -50;
                    if (s.x < -50) s.x = this.canvas.width + 50;
                });

                // Update Particles
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    const p = this.particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.15; // Gravity
                    p.alpha -= 0.03;
                    if (p.alpha <= 0) this.particles.splice(i, 1);
                }
            }

            draw() {
                const width = this.canvas.width;
                const height = this.canvas.height;
                const loc = LOCATIONS.find(l => l.id === this.currentLocationId);

                // 1. Draw Sky Gradient
                const skyGrad = this.ctx.createLinearGradient(0, 0, 0, height * 0.55);
                skyGrad.addColorStop(0, loc.skyColor);
                skyGrad.addColorStop(1, '#e0f2fe');
                this.ctx.fillStyle = skyGrad;
                this.ctx.fillRect(0, 0, width, height * 0.55);

                // 2. Draw Background Scenery (Mountains/Trees)
                this.drawScenery(width, height, loc.bgType);

                // 3. Draw Water Body
                const waterY = height * 0.52;
                const waterGrad = this.ctx.createLinearGradient(0, waterY, 0, height);
                waterGrad.addColorStop(0, loc.waterColor);
                waterGrad.addColorStop(1, loc.bgColor);
                this.ctx.fillStyle = waterGrad;
                this.ctx.fillRect(0, waterY, width, height - waterY);

                // Water Surface Waves Animation
                this.ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
                this.ctx.beginPath();
                this.ctx.moveTo(0, waterY);
                for (let x = 0; x <= width; x += 20) {
                    const y = waterY + Math.sin(x * 0.02 + this.waveOffset) * 4;
                    this.ctx.lineTo(x, y);
                }
                this.ctx.lineTo(width, height);
                this.ctx.lineTo(0, height);
                this.ctx.fill();

                // 4. Draw Ambient Fish Shadows
                this.ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
                this.fishShadows.forEach(s => {
                    this.ctx.beginPath();
                    this.ctx.ellipse(s.x, s.y, s.size, s.size * 0.35, 0, 0, Math.PI * 2);
                    this.ctx.fill();
                });

                // 5. Draw Angler & Pier
                this.drawAngler(width, height);

                // 6. Draw Fishing Line & Bobber
                if (this.bobber.inWater || this.state === 'CASTING' || this.state === 'REELING' || this.state === 'WAITING' || this.state === 'BITING') {
                    const rodTipX = width * 0.18;
                    const rodTipY = height * 0.32;

                    this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
                    this.ctx.lineWidth = 1.2;
                    this.ctx.beginPath();
                    this.ctx.moveTo(rodTipX, rodTipY);
                    
                    // Saggy Line curve
                    const midX = (rodTipX + this.bobber.x) / 2;
                    const midY = Math.max(rodTipY, this.bobber.y) + (this.state === 'REELING' ? 10 : 30);
                    this.ctx.quadraticCurveTo(midX, midY, this.bobber.x, this.bobber.y);
                    this.ctx.stroke();

                    // Bobber
                    this.ctx.fillStyle = '#ef4444'; // Red Top
                    this.ctx.beginPath();
                    this.ctx.arc(this.bobber.x, this.bobber.y - 4, 5, Math.PI, 0);
                    this.ctx.fill();

                    this.ctx.fillStyle = '#ffffff'; // White Bottom
                    this.ctx.beginPath();
                    this.ctx.arc(this.bobber.x, this.bobber.y - 4, 5, 0, Math.PI);
                    this.ctx.fill();

                    // Ripple Rings if in water
                    if (this.bobber.inWater) {
                        const r = (Math.sin(this.waveOffset * 3) + 1) * 6;
                        this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
                        this.ctx.lineWidth = 1;
                        this.ctx.beginPath();
                        this.ctx.ellipse(this.bobber.x, this.bobber.y, r + 4, (r + 4) * 0.3, 0, 0, Math.PI * 2);
                        this.ctx.stroke();
                    }
                }

                // 7. Draw Splash Particles
                this.particles.forEach(p => {
                    this.ctx.fillStyle = `rgba(224, 242, 254, ${p.alpha})`;
                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    this.ctx.fill();
                });
            }

            drawScenery(w, h, type) {
                this.ctx.fillStyle = type === 'mountain' ? '#475569' : (type === 'ocean' ? '#0369a1' : '#15803d');
                // Distant Hills / Mountains Silhouette
                this.ctx.beginPath();
                this.ctx.moveTo(0, h * 0.55);
                this.ctx.lineTo(0, h * 0.35);
                this.ctx.quadraticCurveTo(w * 0.25, h * 0.2, w * 0.5, h * 0.4);
                this.ctx.quadraticCurveTo(w * 0.75, h * 0.15, w, h * 0.38);
                this.ctx.lineTo(w, h * 0.55);
                this.ctx.fill();
            }

            drawAngler(w, h) {
                const pierX = 0;
                const pierY = h * 0.48;

                // Wooden Pier
                this.ctx.fillStyle = '#78350f';
                this.ctx.fillRect(pierX, pierY, w * 0.16, 14);
                this.ctx.fillStyle = '#451a03';
                this.ctx.fillRect(w * 0.12, pierY, 10, h * 0.2);

                // Fisherman Silhouette
                const anglerX = w * 0.1;
                const anglerY = pierY - 28;

                this.ctx.fillStyle = '#1e293b';
                // Body
                this.ctx.fillRect(anglerX, anglerY, 14, 28);
                // Head
                this.ctx.beginPath();
                this.ctx.arc(anglerX + 7, anglerY - 8, 8, 0, Math.PI * 2);
                this.ctx.fill();

                // Fishing Rod Stick
                this.ctx.strokeStyle = '#d97706';
                this.ctx.lineWidth = 3;
                this.ctx.beginPath();
                this.ctx.moveTo(anglerX + 7, anglerY + 5);
                this.ctx.lineTo(w * 0.18, h * 0.32);
                this.ctx.stroke();
            }

            // ==========================================
            // SAVE / LOAD SYSTEM (Local Storage)
            // ==========================================

            saveGame() {
                const data = {
                    coins: this.coins,
                    level: this.level,
                    xp: this.xp,
                    inventoryRods: this.inventoryRods,
                    inventoryBaits: this.inventoryBaits,
                    currentRodId: this.currentRodId,
                    currentBaitId: this.currentBaitId,
                    catchLog: this.catchLog
                };
                localStorage.setItem('meister_angler_save', JSON.stringify(data));
            }

            loadSave() {
                const saved = localStorage.getItem('meister_angler_save');
                if (saved) {
                    try {
                        const data = JSON.parse(saved);
                        this.coins = data.coins ?? 50;
                        this.level = data.level ?? 1;
                        this.xp = data.xp ?? 0;
                        this.inventoryRods = data.inventoryRods || ['rod_wood'];
                        this.inventoryBaits = data.inventoryBaits || { 'bait_worm': 15 };
                        this.currentRodId = data.currentRodId || 'rod_wood';
                        this.currentBaitId = data.currentBaitId || 'bait_worm';
                        this.catchLog = data.catchLog || {};
                    } catch (e) {
                        console.error("Save state corrupt, starting fresh.", e);
                    }
                }
            }
        }

        // Initialize Game Instance on Page Load
        let game = null;
        window.onload = () => {
            game = new FishingGame();
        };
    </script>
</body>
