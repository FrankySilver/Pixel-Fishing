                    { id: 'q21', mapId: 4, title: 'König des Urwalds', desc: 'Fange den legendären Arapaima.', targetFish: 'arapaima', targetCount: 1, rewardGold: 15000, rewardXp: 8000 }
                ];
            }

            init() {
                this.checkSaveGame();
                this.updateCharPreview();
                this.initCanvasEvents();
            }

            checkSaveGame() {
                const saved = localStorage.getItem(this.saveKey);
                if (saved) {
                    document.getElementById('btn-continue').removeAttribute('disabled');
                    document.getElementById('btn-continue').classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }

            saveGame() {
                localStorage.setItem(this.saveKey, JSON.stringify({
                    player: this.player,
                    settings: this.settings
                }));
            }

            loadGame() {
                const saved = localStorage.getItem(this.saveKey);
                if (saved) {
                    const data = JSON.parse(saved);
                    this.player = data.player;
                    this.settings = data.settings || this.settings;
                    this.startGameplay();
                }
            }

            startNewGameSetup() {
                document.getElementById('screen-main-menu').classList.add('hidden');
                document.getElementById('screen-char-create').classList.remove('hidden');
                this.updateCharPreview();
            }

            returnToMainMenu() {
                document.getElementById('screen-char-create').classList.add('hidden');
                document.getElementById('screen-settings').classList.add('hidden');
                document.getElementById('screen-main-menu').classList.remove('hidden');
            }

            openSettings() {
                document.getElementById('screen-settings').classList.remove('hidden');
            }

            closeSettings() {
                document.getElementById('screen-settings').classList.add('hidden');
            }

            setGender(gender) {
                this.player.gender = gender;
                document.getElementById('btn-gender-male').className = gender === 'male' ? 'retro-btn bg-emerald-600 text-white pixel-font py-2 px-3 text-xs rounded' : 'retro-btn bg-slate-800 text-white pixel-font py-2 px-3 text-xs rounded';
                document.getElementById('btn-gender-female').className = gender === 'female' ? 'retro-btn bg-emerald-600 text-white pixel-font py-2 px-3 text-xs rounded' : 'retro-btn bg-slate-800 text-white pixel-font py-2 px-3 text-xs rounded';
                this.updateCharPreview();
            }

            changeCustom(type, delta) {
                if (type === 'hair') {
                    this.player.hair = ((this.player.hair - 1 + delta + 5) % 5) + 1;
                    document.getElementById('lbl-hair').innerText = this.player.hair;
                    document.getElementById('val-hair').innerText = `Stil ${this.player.hair}`;
                } else if (type === 'hat') {
                    this.player.hat = (this.player.hat + delta + 6) % 6;
                    document.getElementById('lbl-hat').innerText = this.player.hat;
                    document.getElementById('val-hat').innerText = this.player.hat === 0 ? 'Keiner' : `Hut ${this.player.hat}`;
                } else if (type === 'clothes') {
                    this.player.clothes = ((this.player.clothes - 1 + delta + 5) % 5) + 1;
                    document.getElementById('lbl-clothes').innerText = this.player.clothes;
                    document.getElementById('val-clothes').innerText = `Stil ${this.player.clothes}`;
                } else if (type === 'boots') {
                    this.player.boots = ((this.player.boots - 1 + delta + 5) % 5) + 1;
                    document.getElementById('lbl-boots').innerText = this.player.boots;
                    document.getElementById('val-boots').innerText = `Stil ${this.player.boots}`;
                }
                this.updateCharPreview();
            }

            updateCharPreview() {
                const canvas = document.getElementById('char-preview-canvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                ctx.imageSmoothingEnabled = false;
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                // Draw background tile
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Pixelart Character preview rendering
                const cx = canvas.width / 2;
                const cy = canvas.height / 2 + 10;

                // Shadow
                ctx.fillStyle = 'rgba(0,0,0,0.4)';
                ctx.beginPath();
                ctx.ellipse(cx, cy + 32, 20, 8, 0, 0, Math.PI * 2);
                ctx.fill();

                // Boots
                ctx.fillStyle = this.player.boots === 1 ? '#78350f' : this.player.boots === 2 ? '#334155' : '#b45309';
                ctx.fillRect(cx - 14, cy + 20, 10, 12);
                ctx.fillRect(cx + 4, cy + 20, 10, 12);

                // Clothes / Body
                ctx.fillStyle = this.player.clothes === 1 ? '#047857' : this.player.clothes === 2 ? '#1d4ed8' : this.player.clothes === 3 ? '#b91c1c' : '#7c3aed';
                ctx.fillRect(cx - 16, cy - 4, 32, 26);

                // Head / Skin
                ctx.fillStyle = '#fde047';
                ctx.fillRect(cx - 12, cy - 22, 24, 20);

                // Hair
                ctx.fillStyle = this.player.hair === 1 ? '#451a03' : this.player.hair === 2 ? '#b45309' : '#1e293b';
                ctx.fillRect(cx - 14, cy - 26, 28, 8);
                if (this.player.hair === 3) ctx.fillRect(cx - 14, cy - 22, 4, 16);

                // Hat
                if (this.player.hat > 0) {
                    ctx.fillStyle = this.player.hat === 1 ? '#065f46' : '#1e3a8a';
                    ctx.fillRect(cx - 18, cy - 30, 36, 6);
                    ctx.fillRect(cx - 12, cy - 38, 24, 10);
                }
            }

            finishCharacterCreation() {
                const nameInput = document.getElementById('char-name-input').value.trim();
                if (nameInput) this.player.name = nameInput;
                
                // Give starting items
                this.player.inventory.push({ id: 'item_bread', name: 'Brotwürfel (Pack)', type: 'bait', baitId: 'bait_bread', count: 15 });
                this.player.inventory.push({ id: 'item_worm', name: 'Tauworm (Pack)', type: 'bait', baitId: 'bait_worm', count: 5 });

                document.getElementById('screen-char-create').classList.add('hidden');
                this.startGameplay();
            }

            startGameplay() {
                document.getElementById('screen-main-menu').classList.add('hidden');
                document.getElementById('screen-game').classList.remove('hidden');

                this.initWorldCanvas();
                this.saveGame();
            }

            initWorldCanvas() {
                const container = document.getElementById('canvas-container');
                const canvas = document.getElementById('game-canvas');
                canvas.width = container.clientWidth;
                canvas.height = container.clientHeight;
                this.world.width = canvas.width;
                this.world.height = canvas.height;
                this.world.canvas = canvas;
                this.world.ctx = canvas.getContext('2d');
                this.world.ctx.imageSmoothingEnabled = false;

                // Spawn player near shore / center
                this.world.playerX = canvas.width / 2;
                this.world.playerY = canvas.height / 2;

                // Event listeners for WASD & Mouse
                window.addEventListener('keydown', (e) => {
                    this.world.keys[e.key.toLowerCase()] = true;
                    if (e.key.toLowerCase() === 'i') this.openInventory();
                });
                window.addEventListener('keyup', (e) => {
                    this.world.keys[e.key.toLowerCase()] = false;
                });

                canvas.addEventListener('mousedown', (e) => {
                    const rect = canvas.getBoundingClientRect();
                    const mx = e.clientX - rect.left;
                    const my = e.clientY - rect.top;
                    this.handleCanvasClick(mx, my);
                });

                // Start main game loop
                if (!this.loopRunning) {
                    this.loopRunning = true;
                    requestAnimationFrame(() => this.gameLoop());
                }
            }

            gameLoop() {
                this.updateWorld();
                this.renderWorld();
                requestAnimationFrame(() => this.gameLoop());
            }

            updateWorld() {
                let dx = 0;
                let dy = 0;
                if (this.world.keys['w'] || this.world.keys['arrowup']) dy -= 1;
                if (this.world.keys['s'] || this.world.keys['arrowdown']) dy += 1;
                if (this.world.keys['a'] || this.world.keys['arrowleft']) dx -= 1;
                if (this.world.keys['d'] || this.world.keys['arrowright']) dx += 1;

                if (dx !== 0 && dy !== 0) {
                    dx *= 0.7071;
                    dy *= 0.7071;
                }

                this.world.playerX += dx * this.world.speed;
                this.world.playerY += dy * this.world.speed;

                // Boundaries & Water collision (Lake is on the right/bottom side of map)
                const currentMapObj = WATERS[this.player.currentMap];
                
                // Keep within canvas bounds
                this.world.playerX = Math.max(30, Math.min(this.world.width - 30, this.world.playerX));
                this.world.playerY = Math.max(50, Math.min(this.world.height - 30, this.world.playerY));

                // Check proximity to water or NPCs
                this.checkInteractions();
            }

            renderWorld() {
                const ctx = this.world.ctx;
                const mapObj = WATERS[this.player.currentMap];

                // Clear background (Grass / Terrain)
                ctx.fillStyle = mapObj.bgColor;
                ctx.fillRect(0, 0, this.world.width, this.world.height);

                // Draw decorative trees / rocks / bridges
                ctx.fillStyle = mapObj.borderColor;
                ctx.fillRect(50, 50, 120, 80); // Forest patch 1
                ctx.fillRect(this.world.width - 180, this.world.height - 140, 140, 100); // Forest patch 2

                // Draw Lake / Water body on the right side
                const lakeX = this.world.width - 280;
                const lakeY = 80;
                const lakeW = 220;
                const lakeH = this.world.height - 160;

                ctx.fillStyle = mapObj.waterColor;
                ctx.fillRect(lakeX, lakeY, lakeW, lakeH);
                ctx.strokeStyle = mapObj.borderColor;
                ctx.lineWidth = 6;
                ctx.strokeRect(lakeX, lakeY, lakeW, lakeH);

                // Draw Wooden Bridge over water/stream
                ctx.fillStyle = '#78350f';
                ctx.fillRect(lakeX - 40, lakeY + lakeH / 2 - 25, 60, 50);
                ctx.strokeStyle = '#451a03';
                ctx.lineWidth = 2;
                ctx.strokeRect(lakeX - 40, lakeY + lakeH / 2 - 25, 60, 50);

                // Draw NPC 1: Händler / Shopkeeper
                const shopNpcX = 120;
                const shopNpcY = 200;
                ctx.fillStyle = '#b45309';
                ctx.fillRect(shopNpcX - 12, shopNpcY - 20, 24, 30);
                ctx.fillStyle = '#fde047';
                ctx.fillRect(shopNpcX - 8, shopNpcY - 32, 16, 14);
                // Shop NPC label
                ctx.fillStyle = '#ffffff';
                ctx.font = '10px monospace';
                ctx.textAlign = 'center';
                ctx.fillText('Händler', shopNpcX, shopNpcY - 40);

                // Draw NPC 2: Questgeber
                const questNpcX = 120;
                const questNpcY = 400;
                ctx.fillStyle = '#1d4ed8';
                ctx.fillRect(questNpcX - 12, questNpcY - 20, 24, 30);
                ctx.fillStyle = '#fde047';
                ctx.fillRect(questNpcX - 8, questNpcY - 32, 16, 14);
                ctx.fillStyle = '#ffffff';
                ctx.fillText('Questgeber', questNpcX, questNpcY - 40);

                // Draw Player Character
                const px = this.world.playerX;
                const py = this.world.playerY;

                // Shadow
                ctx.fillStyle = 'rgba(0,0,0,0.5)';
                ctx.beginPath();
                ctx.ellipse(px, py + 16, 14, 6, 0, 0, Math.PI * 2);
                ctx.fill();

                // Boots
                ctx.fillStyle = '#334155';
                ctx.fillRect(px - 10, py + 8, 8, 10);
                ctx.fillRect(px + 2, py + 8, 8, 10);

                // Body / Clothes
                ctx.fillStyle = this.player.clothes === 1 ? '#047857' : '#1d4ed8';
                ctx.fillRect(px - 12, py - 8, 24, 18);

                // Head
                ctx.fillStyle = '#fde047';
                ctx.fillRect(px - 9, py - 20, 18, 14);

                // Hat
                if (this.player.hat > 0) {
                    ctx.fillStyle = '#065f46';
                    ctx.fillRect(px - 12, py - 26, 24, 6);
                }

                // Player Name Tag
                ctx.fillStyle = '#38bdf8';
                ctx.font = '10px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(this.player.name, px, py - 32);

                // Update HUD info
                document.getElementById('hud-map-name').innerText = mapObj.name;
                document.getElementById('hud-money').innerText = `${this.player.gold} Gold`;
                document.getElementById('hud-level').innerText = `Lv. ${this.player.level} (${this.player.xp}/${this.player.nextXp} XP)`;
            }

            checkInteractions() {
                const px = this.world.playerX;
                const py = this.world.playerY;
                const tooltip = document.getElementById('interaction-tooltip');
                const tooltipText = document.getElementById('tooltip-text');

                // Check distance to Shop NPC (120, 200)
                const distShop = Math.hypot(px - 120, py - 200);
                // Check distance to Quest NPC (120, 400)
                const distQuest = Math.hypot(px - 120, py - 400);
                // Check if near lake shore (lakeX = width - 280)
                const lakeX = this.world.width - 280;
                const isNearWater = px >= lakeX - 40 && px <= lakeX + 20;

                if (distShop < 40) {
                    tooltip.classList.remove('hidden');
                    tooltipText.innerText = 'Klicke hier oder drücke Linksklick zum Händler-Shop!';
                    this.currentInteract = 'shop';
                } else if (distQuest < 40) {
                    tooltip.classList.remove('hidden');
                    tooltipText.innerText = 'Klicke hier zum Questgeber sprechen!';
                    this.currentInteract = 'quest';
                } else if (isNearWater) {
                    tooltip.classList.remove('hidden');
                    tooltipText.innerText = 'Linksklick ins Wasser zum Angeln!';
                    this.currentInteract = 'fish';
                } else {
                    tooltip.classList.add('hidden');
                    this.currentInteract = null;
                }
            }

            handleCanvasClick(mx, my) {
                // Check NPC clicks or Fishing click
                const distShop = Math.hypot(mx - 120, my - 200);
                const distQuest = Math.hypot(mx - 120, my - 400);
                const lakeX = this.world.width - 280;

                if (distShop < 45) {
                    this.openShop();
                } else if (distQuest < 45) {
                    this.openQuests();
                } else if (mx >= lakeX - 50) {
                    // Start Fishing Minigame
                    FishingGame.startCasting();
                }
            }

            openInventory() {
                document.getElementById('modal-inventory').classList.remove('hidden');
                this.renderInventoryUI();
            }

            renderInventoryUI() {
                document.getElementById('net-count').innerText = this.player.net.length;
                
                // Render Baits list
                const baitsContainer = document.getElementById('inv-baits-list');
                baitsContainer.innerHTML = '';
                Object.keys(this.player.baits).forEach(bKey => {
                    const count = this.player.baits[bKey];
                    const activeClass = this.player.activeBait === bKey ? 'border-emerald-500 bg-emerald-950/40' : 'border-slate-800 bg-slate-900';
                    baitsContainer.innerHTML += `
                        <div onclick="Game.setActiveBait('${bKey}')" class="p-2 rounded border ${activeClass} cursor-pointer flex justify-between items-center text-xs">
                            <span class="text-slate-300 capitalize">${bKey.replace('bait_', '')}</span>
                            <span class="pixel-font text-amber-400">${count}x</span>
                        </div>
                    `;
                });

                // Render Net Fish List (Up to 25)
                const netContainer = document.getElementById('net-fish-list');
                netContainer.innerHTML = '';
                for (let i = 0; i < 25; i++) {
                    const fish = this.player.net[i];
                    if (fish) {
                        netContainer.innerHTML += `
                            <div class="bg-slate-800 p-2 rounded border border-slate-700 flex flex-col items-center justify-center text-center relative group">
                                <i class="fa-solid fa-fish text-emerald-400 text-lg mb-1"></i>
                                <span class="text-[9px] text-white truncate w-full">${fish.name}</span>
                                <span class="text-[8px] text-amber-300">${fish.weight} kg</span>
                            </div>
                        `;
                    } else {
                        netContainer.innerHTML += `<div class="bg-slate-950/40 rounded border border-dashed border-slate-800 flex items-center justify-center text-slate-700 text-xs">${i+1}</div>`;
                    }
                }

                // Render General Inventory (24 slots)
                const invContainer = document.getElementById('inventory-grid');
                invContainer.innerHTML = '';
                for (let i = 0; i < 24; i++) {
                    const item = this.player.inventory[i];
                    if (item) {
                        invContainer.innerHTML += `
                            <div class="bg-slate-800 p-2 rounded border border-slate-700 flex flex-col items-center justify-center text-center text-xs">
                                <i class="fa-solid fa-box text-sky-400 mb-1"></i>
                                <span class="text-[9px] text-white truncate w-full">${item.name}</span>
                            </div>
                        `;
                    } else {
                        invContainer.innerHTML += `<div class="bg-slate-950/40 rounded border border-dashed border-slate-800 flex items-center justify-center text-slate-700 text-[10px]">${i+1}</div>`;
                    }
                }
            }

            setActiveBait(bKey) {
                this.player.activeBait = bKey;
                this.renderInventoryUI();
            }

            sellAllFish() {
                let totalGold = 0;
                this.player.net.forEach(fish => {
                    let price = fish.basePrice * (fish.weight / 2);
                    totalGold += Math.round(price);
                });
                this.player.gold += Math.round(totalGold * (1 + (this.player.goldBonus || 0)));
                this.player.net = [];
                this.renderInventoryUI();
                this.saveGame();
            }

            openFishBook() {
                document.getElementById('modal-fishbook').classList.remove('hidden');
                const container = document.getElementById('fishbook-list');
                container.innerHTML = '';

                Object.keys(FISH_SPECIES).forEach(fKey => {
                    const species = FISH_SPECIES[fKey];
                    const entry = this.player.fishBook[fKey];
                    const caught = entry && entry.caught;

                    container.innerHTML += `
                        <div class="p-3 rounded-lg border ${caught ? 'bg-slate-900 border-emerald-600/50' : 'bg-slate-950 border-slate-800 opacity-50'} flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded bg-slate-800 flex items-center justify-center text-xl ${caught ? 'text-emerald-400' : 'text-slate-600'}">
                                    <i class="fa-solid fa-fish"></i>
                                </div>
                                <div>
                                    <h4 class="pixel-font text-xs ${caught ? 'text-white' : 'text-slate-500'}">${species.name}</h4>
                                    <p class="text-[10px] text-slate-400">Gewässer: ${WATERS[species.mapId].name} &bull; Seltenheit: Lvl ${species.rarity}</p>
                                </div>
                            </div>
                            <div class="text-right text-xs">
                                ${caught ? `
                                    <p class="text-amber-300 pixel-font text-[10px]">Max: ${entry.maxWeight} kg</p>
                                    <p class="text-slate-400 text-[10px]">Gefangen: ${entry.count}x</p>
                                ` : `<span class="pixel-font text-[10px] text-slate-600">Noch nie gefangen</span>`}
                            </div>
                        </div>
                    `;
                });
            }

            openQuests() {
                document.getElementById('modal-quests').classList.remove('hidden');
                const container = document.getElementById('quests-list');
                container.innerHTML = '';

                this.questsData.forEach(q => {
                    const prog = this.player.questsProgress[q.id] || { count: 0, completed: false };
                    const isCurrentMap = q.mapId === this.player.currentMap;
                    
                    container.innerHTML += `
                        <div class="p-4 rounded-lg border ${prog.completed ? 'bg-emerald-950/30 border-emerald-700/50' : 'bg-slate-900 border-slate-800'} flex flex-col gap-2">
                            <div class="flex justify-between items-center">
                                <h4 class="pixel-font text-xs text-amber-300">${q.title}</h4>
                                <span class="text-[10px] text-slate-400">Gewässer: ${WATERS[q.mapId].name}</span>
                            </div>
                            <p class="text-xs text-slate-300">${q.desc}</p>
                            <div class="flex justify-between items-center pt-2 border-t border-slate-800 text-xs">
                                <span class="text-slate-400">Fortschritt: <b class="text-white">${prog.count}/${q.targetCount}</b></span>
                                <span class="text-amber-400 pixel-font text-[10px]">Belohnung: ${q.rewardGold} Gold &bull; ${q.rewardXp} XP</span>
                                ${!prog.completed && prog.count >= q.targetCount ? `
                                    <button onclick="Game.claimQuest('${q.id}')" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font px-3 py-1 text-[10px] rounded">Belohnung abholen</button>
                                ` : prog.completed ? `
                                    <span class="text-emerald-400 pixel-font text-[10px]"><i class="fa-solid fa-check"></i> Erfüllt</span>
                                ` : `
                                    <span class="text-slate-500 pixel-font text-[10px]">Offen</span>
                                `}
                            </div>
                        </div>
                    `;
                });
            }

            claimQuest(qId) {
                const q = this.questsData.find(x => x.id === qId);
                if (!q) return;
                if (!this.player.questsProgress[qId]) this.player.questsProgress[qId] = { count: q.targetCount, completed: false };
                
                if (!this.player.questsProgress[qId].completed) {
                    this.player.questsProgress[qId].completed = true;
                    this.player.gold += q.rewardGold;
                    this.addXp(q.rewardXp);
                    this.openQuests();
                    this.saveGame();
                }
            }

            addXp(amount) {
                this.player.xp += amount;
                if (this.player.xp >= this.player.nextXp) {
                    this.player.xp -= this.player.nextXp;
                    this.player.level++;
                    this.player.nextXp = Math.round(this.player.nextXp * 1.3);
                    this.player.skillPoints += 1;
                    alert(`LEVEL UP! Du bist jetzt Stufe ${this.player.level}! +1 Fertigkeitspunkt erhalten.`);
                }
                this.saveGame();
            }

            openSkills() {
                document.getElementById('modal-skills').classList.remove('hidden');
                document.getElementById('skills-points-badge').innerText = `Verfügbare Punkte: ${this.player.skillPoints}`;
                const container = document.getElementById('skills-list');
                container.innerHTML = '';

                SKILLS_LIST.forEach(s => {
                    const unlocked = this.player.unlockedSkills.includes(s.id);
                    container.innerHTML += `
                        <div class="p-3 rounded-lg border ${unlocked ? 'bg-pink-950/30 border-pink-700/50' : 'bg-slate-900 border-slate-800'} flex justify-between items-center">
                            <div>
                                <h4 class="pixel-font text-xs ${unlocked ? 'text-pink-300' : 'text-white'}">${s.name}</h4>
                                <p class="text-[10px] text-slate-400 mt-1">${s.desc}</p>
                                <span class="text-[9px] text-amber-400 pixel-font">Kosten: ${s.cost} Punkt(e)</span>
                            </div>
                            <div>
                                ${unlocked ? `
                                    <span class="text-pink-400 pixel-font text-[10px]"><i class="fa-solid fa-check"></i> Aktiv</span>
                                ` : `
                                    <button onclick="Game.unlockSkill('${s.id}')" class="retro-btn bg-pink-600 hover:bg-pink-500 text-white pixel-font px-3 py-1 text-[10px] rounded">Freischalten</button>
                                `}
                            </div>
                        </div>
                    `;
                });
            }

            unlockSkill(sId) {
                const s = SKILLS_LIST.find(x => x.id === sId);
                if (!s) return;
                if (this.player.skillPoints >= s.cost && !this.player.unlockedSkills.includes(sId)) {
                    this.player.skillPoints -= s.cost;
                    this.player.unlockedSkills.push(sId);
                    s.effect(this.player);
                    this.openSkills();
                    this.saveGame();
                }
            }

            openShop() {
                document.getElementById('modal-shop').classList.remove('hidden');
                const mapObj = WATERS[this.player.currentMap];
                document.getElementById('shop-title').innerHTML = `<i class="fa-solid fa-store"></i> Händler - ${mapObj.name}`;
                const container = document.getElementById('shop-content');
                container.innerHTML = `
                    <h3 class="pixel-font text-xs text-emerald-400">Ruten im Angebot</h3>
                    <div class="grid grid-cols-1 gap-2 mb-4">
                        ${mapObj.shopRods.map(r => `
                            <div class="bg-slate-900 p-3 rounded border border-slate-800 flex justify-between items-center text-xs">
                                <div>
                                    <h4 class="pixel-font text-white">${r.name}</h4>
                                    <span class="text-[10px] text-slate-400">Kraft-Faktor: ${r.power}x</span>
                                </div>
                                ${this.player.unlockedRods.includes(r.id) ? `
                                    <span class="text-emerald-400 pixel-font text-[10px]">Gekauft</span>
                                ` : `
                                    <button onclick="Game.buyRod('${r.id}', ${r.price})" class="retro-btn bg-emerald-600 hover:bg-emerald-500 text-white pixel-font px-3 py-1 text-[10px] rounded">${r.price} Gold</button>
                                `}
                            </div>
                        `).join('')}
                    </div>

                    <h3 class="pixel-font text-xs text-sky-400">Köder & Nachschub</h3>
                    <div class="grid grid-cols-1 gap-2 mb-4">
                        ${mapObj.shopBaits.map(b => `
                            <div class="bg-slate-900 p-3 rounded border border-slate-800 flex justify-between items-center text-xs">
                                <div>
                                    <h4 class="pixel-font text-white">${b.name} (${b.amount} Stk.)</h4>
                                </div>
                                <button onclick="Game.buyBait('${b.id}', ${b.price}, ${b.amount})" class="retro-btn bg-sky-600 hover:bg-sky-500 text-white pixel-font px-3 py-1 text-[10px] rounded">${b.price} Gold</button>
                            </div>
                        `).join('')}
                    </div>

                    <h3 class="pixel-font text-xs text-amber-400">Messer für Filetierung</h3>
                    <div class="grid grid-cols-1 gap-2">
                        ${mapObj.shopKnives.map(k => `
                            <div class="bg-slate-900 p-3 rounded border border-slate-800 flex justify-between items-center text-xs">
                                <div>
                                    <h4 class="pixel-font text-white">${k.name} (Stufe ${k.tier})</h4>
                                </div>
                                ${this.player.unlockedKnives.includes(k.id) ? `
                                    <span class="text-emerald-400 pixel-font text-[10px]">Besessen</span>
                                ` : `
                                    <button onclick="Game.buyKnife('${k.id}', ${k.price})" class="retro-btn bg-amber-600 hover:bg-amber-500 text-white pixel-font px-3 py-1 text-[10px] rounded">${k.price} Gold</button>
                                `}
                            </div>
                        `).join('')}
                    </div>
                `;
            }

            buyRod(rId, price) {
                if (this.player.gold >= price) {
                    this.player.gold -= price;
                    this.player.unlockedRods.push(rId);
                    this.player.currentRod = rId;
                    this.openShop();
                    this.saveGame();
                } else {
                    alert('Nicht genug Gold!');
                }
            }

            buyBait(bId, price, amount) {
                if (this.player.gold >= price) {
                    this.player.gold -= price;
                    this.player.baits[bId] = (this.player.baits[bId] || 0) + amount;
                    this.openShop();
                    this.saveGame();
                } else {
                    alert('Nicht genug Gold!');
                }
            }

            buyKnife(kId, price) {
                if (this.player.gold >= price) {
                    this.player.gold -= price;
                    this.player.unlockedKnives.push(kId);
                    this.player.currentKnife = kId;
                    this.openShop();
                    this.saveGame();
                } else {
                    alert('Nicht genug Gold!');
                }
            }

            openMapSelect() {
                document.getElementById('modal-mapselect').classList.remove('hidden');
                const container = document.getElementById('map-list');
                container.innerHTML = '';

                WATERS.forEach(m => {
                    const unlocked = this.player.level >= m.reqLevel;
                    const isCurrent = this.player.currentMap === m.id;

                    container.innerHTML += `
                        <div class="p-4 rounded-lg border ${isCurrent ? 'bg-indigo-950/40 border-indigo-500' : unlocked ? 'bg-slate-900 border-slate-700' : 'bg-slate-950 border-slate-900 opacity-50'} flex flex-col justify-between gap-3">
                            <div>
                                <h4 class="pixel-font text-xs text-white">${m.name} ${isCurrent ? '(Aktuell)' : ''}</h4>
                                <p class="text-xs text-slate-400 mt-1">${m.desc}</p>
                                <span class="text-[10px] text-amber-400 pixel-font mt-2 block">Benötigte Stufe: ${m.reqLevel}</span>
                            </div>
                            <div>
                                ${isCurrent ? `
                                    <span class="text-indigo-400 pixel-font text-[10px]">Hier bist du gerade</span>
                                ` : unlocked ? `
                                    <button onclick="Game.travelToMap(${m.id})" class="retro-btn bg-indigo-600 hover:bg-indigo-500 text-white pixel-font px-4 py-2 text-xs rounded w-full">Dorthin reisen</button>
                                ` : `
                                    <span class="text-slate-500 pixel-font text-[10px]">Noch gesperrt (Stufe ${m.reqLevel})</span>
                                `}
                            </div>
                        </div>
                    `;
                });
            }

            travelToMap(mapId) {
                this.player.currentMap = mapId;
                this.closeModals();
                this.saveGame();
            }

            closeModals() {
                document.getElementById('modal-inventory').classList.add('hidden');
                document.getElementById('modal-fishbook').classList.add('hidden');
                document.getElementById('modal-quests').classList.add('hidden');
                document.getElementById('modal-skills').classList.add('hidden');
                document.getElementById('modal-shop').classList.add('hidden');
                document.getElementById('modal-mapselect').classList.add('hidden');
            }

            updateVolume(type, val) {
                if (type === 'music') {
                    this.settings.musicVol = val;
                    document.getElementById('val-music-vol').innerText = `${val}%`;
                } else {
                    this.settings.sfxVol = val;
                    document.getElementById('val-sfx-vol').innerText = `${val}%`;
                }
                this.saveGame();
            }
        }

        /* ==========================================
           FISHING & DRILL COMBAT MINIGAME ENGINE
           ========================================== */
        class FishingEngine {
            constructor() {
                this.state = 'idle'; // casting, waiting, drill, success, fail
                this.castPos = 0;
                this.castDir = 1;
                this.animInterval = null;
                this.currentFish = null;
                this.stamina = 100;
                this.tension = 30;
                this.isReeling = false;
                this.qteKey = null;
            }

            startCasting() {
                const activeBait = Game.player.activeBait;
                if ((Game.player.baits[activeBait] || 0) <= 0) {
                    alert('Kein passender Köder mehr im Bestand! Bitte im Shop oder Inventar wechseln.');
                    return;
                }

                document.getElementById('fishing-overlay').classList.remove('hidden');
                document.getElementById('casting-box').classList.remove('hidden');
                document.getElementById('waiting-box').classList.add('hidden');
                document.getElementById('drill-box').classList.add('hidden');

                this.state = 'casting';
                this.castPos = 0;
                this.castDir = 2;

                if (this.animInterval) clearInterval(this.animInterval);
                this.animInterval = setInterval(() => {
                    this.castPos += this.castDir;
                    if (this.castPos >= 100 || this.castPos <= 0) this.castDir *= -1;
                    const cursor = document.getElementById('casting-cursor');
                    if (cursor) cursor.style.left = `${this.castPos}%`;
                }, 20);
            }

            confirmCast() {
                if (this.state !== 'casting') return;
                clearInterval(this.animInterval);

                // Check if cast landed in green zone (60% to 85%)
                if (this.castPos >= 60 && this.castPos <= 85) {
                    // Consume bait
                    const b = Game.player.activeBait;
                    if (Game.player.baits[b] > 0) Game.player.baits[b]--;

                    document.getElementById('casting-box').classList.add('hidden');
                    document.getElementById('waiting-box').classList.remove('hidden');
                    this.state = 'waiting';

                    // Random bite delay between 2 and 5 seconds
                    const waitTime = 2000 + Math.random() * 3000;
                    setTimeout(() => {
                        if (this.state === 'waiting') {
                            this.triggerBite();
                        }
                    }, waitTime);
                } else {
                    alert('Fehlwurf! Der Köder landete im Flachen.');
                    this.cancelFishing();
                }
            }

            triggerBite() {
                this.state = 'drill';
                document.getElementById('waiting-box').classList.add('hidden');
                document.getElementById('drill-box').classList.remove('hidden');

                // Pick random fish from current map
                const mapObj = WATERS[Game.player.currentMap];
                const availableFishIds = mapObj.fishIds;
                const randomFishId = availableFishIds[Math.floor(Math.random() * availableFishIds.length)];
                const species = FISH_SPECIES[randomFishId];

                const weight = +(species.minW + Math.random() * (species.maxW - species.minW)).toFixed(2);
                const length = +(weight * 8 + Math.random() * 10).toFixed(1);

                this.currentFish = {
                    id: randomFishId,
                    name: species.name,
                    weight: weight,
                    length: length,
                    basePrice: species.basePrice,
                    stamina: 100,
                    maxStamina: 100,
                    aggression: species.rarity
                };

                document.getElementById('drill-fish-name').innerText = `${this.currentFish.name} (${weight} kg)`;
                this.stamina = 100;
                this.tension = 30;

                // Start Drill tick loop
                if (this.drillInterval) clearInterval(this.drillInterval);
                this.drillInterval = setInterval(() => this.updateDrill(), 100);
            }

            updateDrill() {
                if (this.state !== 'drill') return;

                if (this.isReeling) {
                    this.stamina -= 3;
                    this.tension += 4;
                } else {
                    this.tension -= 2;
                }

                this.tension = Math.max(0, Math.min(100, this.tension));

                // Update UI Bars
                document.getElementById('drill-stamina-bar').style.width = `${Math.max(0, this.stamina)}%`;
                document.getElementById('drill-stamina-text').innerText = `${Math.round(this.stamina)}%`;
                document.getElementById('drill-tension-bar').style.width = `${this.tension}%`;

                const tensionText = document.getElementById('drill-tension-text');
                if (this.tension > 80) {
                    tensionText.innerText = 'GEFAHR: Schnur reißt!';
                    tensionText.className = 'text-red-400 pixel-font';
                    if (this.tension >= 100) {
                        this.failFishing('Die Schnur ist gerissen!');
                    }
                } else {
                    tensionText.innerText = 'Sicher';
                    tensionText.className = 'text-emerald-400 pixel-font';
                }

                if (this.stamina <= 0) {
                    this.successFishing();
                }
            }

            startReeling() {
                this.isReeling = true;
            }

            stopReeling() {
                this.isReeling = false;
            }

            successFishing() {
                clearInterval(this.drillInterval);
                this.state = 'success';
                document.getElementById('fishing-overlay').classList.add('hidden');

                const fish = this.currentFish;
                // Add to Net (max 25)
                if (Game.player.net.length < 25) {
                    Game.player.net.push(fish);
                } else {
                    Game.player.inventory.push({ id: fish.id, name: fish.name, type: 'fish', weight: fish.weight });
                }

                // Update Fishbook
                if (!Game.player.fishBook[fish.id]) {
                    Game.player.fishBook[fish.id] = { caught: true, maxWeight: fish.weight, maxLength: fish.length, count: 1 };
                } else {
                    Game.player.fishBook[fish.id].caught = true;
                    Game.player.fishBook[fish.id].count++;
                    if (fish.weight > Game.player.fishBook[fish.id].maxWeight) {
                        Game.player.fishBook[fish.id].maxWeight = fish.weight;
                        Game.player.fishBook[fish.id].maxLength = fish.length;
                    }
                }

                // Check Quests progress
                Game.questsData.forEach(q => {
                    const prog = Game.player.questsProgress[q.id] || { count: 0, completed: false };
                    if (!prog.completed) {
                        if (q.targetFish === fish.id || q.targetFish === 'any') {
                            prog.count++;
                            Game.player.questsProgress[q.id] = prog;
                        }
                    }
                });

                Game.addXp(25 + fish.weight * 2);
                Game.saveGame();

                alert(`ERFOLG! Du hast einen ${fish.name} (${fish.weight} kg, ${fish.length} cm) gefangen!`);
            }

            failFishing(reason) {
                clearInterval(this.drillInterval);
                this.state = 'fail';
                document.getElementById('fishing-overlay').classList.add('hidden');
                alert(`VERLOREN! ${reason}`);
            }

            cancelFishing() {
                if (this.drillInterval) clearInterval(this.drillInterval);
                if (this.animInterval) clearInterval(this.animInterval);
                this.state = 'idle';
                document.getElementById('fishing-overlay').classList.add('hidden');
            }
        }

        // Global Game & Fishing instances
        const Game = new GameEngine();
        const FishingGame = new FishingEngine();

        window.onload = function () {
            Game.init();
        };
    </script>
